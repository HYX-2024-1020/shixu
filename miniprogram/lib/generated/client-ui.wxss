}
.page .world .hero-highlight {
  background: #ffd43b;
  box-shadow:
    10rpx 0 #ffd43b,
    -6rpx 0 #ffd43b;
}
.page .world .world-title {
  font-size: clamp(64rpx, 3.8vw, 86rpx);
  margin: 24rpx 0;
}
.page .world .hero-highlight {
  display: inline-block;
  background: #ffd43b;
  border: 6rpx solid #111;
  border-radius: 8rpx;
  padding: 0 0.14em;
