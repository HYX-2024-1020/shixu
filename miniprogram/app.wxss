page {
  background: #f8f3e3;
  color: #292822;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 32rpx;
}
button { font-size: 30rpx; border-radius: 18rpx; margin: 0; }
button::after { border: none; }
button[disabled] { opacity: .5; }
input, textarea { box-sizing: border-box; font-size: 32rpx; }
