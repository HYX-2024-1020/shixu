/* Isolated card styles: no item-card/button overrides from earlier layouts. */
.page .world .world-grid {
  display: flex;
  flex-direction: column;
  gap: 0;
  margin: 0;
}
.xc-card {
  box-sizing: border-box;
  background: #fff;
  color: #111;
  border: 6rpx solid #111;
  border-radius: 10rpx;
  box-shadow: 8rpx 8rpx #ffd43b;
  padding: 16rpx 20rpx;
  margin: 0 8rpx 20rpx 0;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}
.xc-shadow-1 {
  box-shadow: 8rpx 8rpx #7048e8;
}
.xc-shadow-2 {
  box-shadow: 8rpx 8rpx #ff9fb2;
}
.xc-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.xc-top {
  gap: 4rpx;
}
.xc-hit {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  min-width: 44px;
  height: 44px;
  flex: 0 0 44px;
  box-sizing: border-box;
}
.xc-circle {
  position: relative;
  box-sizing: border-box;
  width: 64rpx;
  height: 64rpx;
  border: 3rpx solid #111;
  border-radius: 50%;
  background: #fff;
}
.xc-checked {
  background: #ffd43b;
}
.xc-circle .completion-check {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
}
.xc-title-touch {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  min-height: 44px;
}
.xc-title {
  display: block;
  width: 100%;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.4;
  color: #111;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.xc-star {
  font-size: 38rpx;
  color: #111;
}
.xc-starred {
  color: #9b6800;
}
.xc-chevron {
  font-size: 26rpx;
  color: #777061;
}
.xc-disabled {
  opacity: 0.45;
}
.xc-info {
  margin-top: 6rpx;
  min-height: 36rpx;
}
.xc-due {
  display: inline-block;
  flex-shrink: 0;
  max-width: calc(100% - 14rpx);
  box-sizing: border-box;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.5;
  color: #111;
  background: #ffe89b;
  border: 3rpx solid #111;
  border-radius: 6rpx;
  padding: 4rpx 14rpx;
  overflow-wrap: anywhere;
}
.xc-overdue {
  background: #ffe5ee;
  border-color: #d6336c;
}
.xc-preview {
  display: block;
  flex: 1;
  min-width: 0;
  color: #777061;
  font-size: 24rpx;
  line-height: 1.5;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.xc-kind-chip,
.xc-tags text {
  display: inline-block;
  flex-shrink: 0;
  background: #eee8ff;
  color: #111;
  border: 3rpx solid #111;
  border-radius: 6rpx;
  padding: 2rpx 12rpx;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.5;
}
.xc-expanded {
  border-top: 3rpx dashed #c9bfa7;
  margin-top: 14rpx;
  padding-top: 14rpx;
}
.xc-summary {
  display: block;
  font-size: 28rpx;
  line-height: 1.7;
  color: #4a4736;
  white-space: pre-wrap;
  word-break: break-all;
}
.xc-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}
.xc-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 6rpx;
}
.xc-link {
  display: flex;
  align-items: center;
  min-height: 44px;
  min-width: 44px;
  font-size: 30rpx;
  line-height: 1.4;
  font-weight: 700;
  color: #7048e8;
  white-space: nowrap;
  flex-shrink: 0;
}
.xc-delete {
  color: #994532;
  margin-left: auto;
}
.xc-restore {
  color: #7048e8;
  font-size: 24rpx;
  font-weight: 700;
}
.xc-attachment {
  margin-top: 4rpx;
}
.xc-press {
  opacity: 0.72;
}
.xc-categories {
  white-space: nowrap;
  margin: 16rpx 0 24rpx;
  padding-bottom: 8rpx;
}
.xc-category {
  display: inline-block;
  box-sizing: border-box;
  min-height: 44px;
  padding: 12rpx 22rpx;
  margin-right: 14rpx;
  border: 4rpx solid transparent;
  border-radius: 8rpx;
  color: #111;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.5;
}
.xc-category-on {
  border-color: #111;
  background: #ffd43b;
  box-shadow: 6rpx 6rpx #111;
}
