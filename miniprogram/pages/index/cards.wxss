/* Isolated card styles: no item-card/button overrides from earlier layouts. */
.page .world .world-grid {
  display: flex;
  flex-direction: column;
  gap: 0;
  margin: 0;
}
.page .xc-card {
  box-sizing: border-box;
  background: #fffef8;
  color: #171713;
  border: 5rpx solid #171713;
  border-radius: 8rpx;
  box-shadow: 6rpx 6rpx #171713, 12rpx 12rpx var(--card-accent, #ffda32);
  margin: 0 12rpx 28rpx 0;
  padding: 12rpx 16rpx 16rpx;
}
.page .xc-top {
  display: flex;
  align-items: center;
  gap: 6rpx;
}
.page .xc-top button,
.page .xc-footer button {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  background: transparent;
  border: 0;
  box-shadow: none;
  color: #171713;
  line-height: 1.25;
}
.page .xc-hit {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  flex: 0 0 44px;
}
.xc-quick-actions {
  display: flex;
  flex-shrink: 0;
}
.page .xc-top .xc-title-touch {
  display: flex;
  align-items: center;
  min-width: 0;
  min-height: 44px;
  flex: 1;
  text-align: left;
}
.page .xc-title {
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.4;
  overflow-wrap: anywhere;
  word-break: break-word;
}
.is-collapsed .xc-title {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.xc-done-card .xc-title {
  color: #514b5b;
  text-decoration: line-through;
}
.xc-circle {
  box-sizing: border-box;
  position: relative;
  width: 42rpx;
  height: 42rpx;
  border: 3rpx solid #171713;
  border-radius: 50%;
  background: #fffef8;
}
.xc-checked { background: var(--card-accent, #ffda32); }
.xc-circle .completion-check {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
}
.page .xc-top .xc-star { font-size: 39rpx; }
.page .xc-top .xc-starred { color: #7c4800; }
.xc-chevron-mark {
  width: 14rpx;
  height: 14rpx;
  border: solid #514b5b;
  border-width: 0 4rpx 4rpx 0;
  transform: translateY(-3rpx) rotate(45deg);
}
.xc-chevron-open .xc-chevron-mark {
  transform: translateY(3rpx) rotate(225deg);
}
.xc-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6rpx 12rpx;
  padding: 0 8rpx;
  color: #625b6b;
  font-size: 23rpx;
  line-height: 1.5;
}
.xc-kind-label, .xc-due {
  box-sizing: border-box;
  max-width: 100%;
  padding: 2rpx 8rpx;
  color: #171713;
  border: 2rpx solid #171713;
  background: var(--card-accent, #ffda32);
  font-weight: 700;
  overflow-wrap: anywhere;
}
.xc-due { background: #fff0b6; }
.xc-overdue { background: #ffcad5; }
.xc-conflict { color: #752036; font-weight: 800; }
.xc-project {
  max-width: 100%;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.xc-expanded {
  margin-top: 16rpx;
  padding: 16rpx 8rpx 6rpx;
  border-top: 2rpx dashed #9e9383;
}
.xc-summary {
  display: block;
  font-size: 28rpx;
  line-height: 1.65;
  color: #3d3743;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
.page .xc-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 14rpx -16rpx -16rpx;
  padding: 6rpx 20rpx;
  border-top: 3rpx solid #171713;
  background: var(--card-paper, #f3ecff);
}
.page .xc-footer .xc-link {
  min-height: 44px;
  font-size: 25rpx;
  font-weight: 800;
}
.page .xc-footer .xc-detail {
  margin-left: auto;
  color: #382766;
}
.page .xc-footer .xc-delete, .page .xc-top .xc-restore {
  color: #751f37;
  font-size: 23rpx;
}
.page .xc-press {
  opacity: 0.68;
  background-color: #e9e0f7;
}
.xc-categories {
  white-space: nowrap;
  margin: 16rpx 0 24rpx;
  padding-bottom: 8rpx;
}
.xc-category {
  display: inline-block;
  box-sizing: border-box;
  min-height: 44px;
  padding: 12rpx 22rpx;
  margin-right: 14rpx;
  border: 4rpx solid transparent;
  border-radius: 8rpx;
  color: #111;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.5;
}
.xc-category-on {
  border-color: #111;
  background: #ffd43b;
  box-shadow: 6rpx 6rpx #111;
}
