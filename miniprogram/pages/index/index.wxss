  100% {
    transform: scale(1);
  }
}
.page .world .item-card .pin-label {
  color: #7048e8;
  font-weight: 600;
}
.page .world .item-card.drag-card,
.page .ddl-workspace .ddl-item.drag-card {
  transition:
    transform 220ms cubic-bezier(0.22, 1, 0.36, 1),
    opacity 180ms ease;
}
.drag-ghost {
  max-height: none;
  display: flex;
  flex-direction: column;
  padding: 18rpx;
  transform: scale(1.025);
  border-radius: 6rpx;
  animation: drag-lift 180ms cubic-bezier(0.22, 1, 0.36, 1);
  box-shadow:
    8rpx 8rpx #7048e8,
    0 12rpx 32rpx #1112;
}
.drag-ghost-title {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
}
.drag-ghost-summary {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  font-size: 24rpx;
  font-weight: 400;
  color: #6d685b;
  margin-top: 12rpx;
}
@keyframes drag-lift {
  from {
    transform: scale(1);
  }
  to {
    transform: scale(1.025);
  }
}
.drag-ghost.is-settling {
  animation: none;
  transform: scale(1);
  opacity: 0;
  transition:
    left 240ms cubic-bezier(0.22, 1, 0.36, 1),
    top 240ms cubic-bezier(0.22, 1, 0.36, 1),
    width 240ms,
    height 240ms,
    transform 240ms,
    opacity 100ms 150ms;
}
@media (prefers-reduced-motion: reduce) {
  .drag-card,
  .drag-ghost,
  .completion-orbit {
    animation: none;
    transition: none;
  }
}
.drag-grip {
  font-size: 22px;
}
.page .ddl-time {
  padding: 4rpx 6rpx;
  gap: 0;
}
.page .ddl-time .ddl-date {
  font-size: 20rpx;
  color: #655f50;
  line-height: 1.35;
}
.page .ddl-time .ddl-clock {
  margin: 0;
  font-size: 29rpx;
  line-height: 1.25;
  color: #111;
  font-weight: 600;
}
.ddl-verify-button {
  width: 100%;
  min-height: 44px;
  height: 44px;
  padding: 0;
  margin: 0;
  border: 0;
  background: transparent;
  color: #7048e8;
  font-size: 22rpx;
  line-height: 44px;
}
.drag-ghost {
  animation: none;
  will-change: transform;
}
/* DDL uses native flex rows: time never competes with the content for a column. */
.page .ddl-item {
  display: flex;
  flex-direction: column;
  height: calc(44px + 120rpx);
  min-height: 100px;
  overflow: hidden;
}
.page .ddl-time {
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  min-height: 44px;
  flex: 0 0 44px;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  flex-wrap: nowrap;
  gap: 14rpx;
  padding: 0 12rpx;
  border-right: 0;
  border-bottom: 1px solid #1113;
}
.page .ddl-time .ddl-date {
  flex: 1;
  min-width: 0;
  margin: 0;
  font-size: 23rpx;
  line-height: 1.4;
  white-space: nowrap;
  text-align: left;
}
.page .ddl-time .ddl-clock {
  flex: 0 0 auto;
  margin: 0;
  font-size: 29rpx;
  line-height: 1.3;
  white-space: nowrap;
}
.page .ddl-time .ddl-verify-button {
  flex: 0 0 auto;
  width: auto;
  min-width: 44px;
  min-height: 44px;
  height: 44px;
  padding: 0 8rpx;
  line-height: 44px;
  white-space: nowrap;
}
.page .ddl-row {
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  min-height: 50px;
  flex: 1;
  padding: 4rpx 12rpx;
  gap: 8rpx;
  align-items: center;
}
.page .ddl-row .ddl-copy {
  flex: 1;
  min-width: 0;
}
.page .ddl-copy .item-title {
  font-size: 28rpx;
  line-height: 34rpx;
  max-height: 68rpx;
}

/* ========== 第二轮：移动端手感进化（2026-10-26） ========== */

/* 按压反馈的统一过渡：只动 transform / shadow / opacity，不触发布局 */
.small-button,
.chip,
.filter,
.primary,
.icon-button,
.text-button,
.done-button,
.category-button,
.skin-home-change,
.item-card,
.skin-card,
.ddl-time,
.ddl-copy,
.ddl-subbar,
.update-banner {
  transition:
    transform 0.14s ease-out,
    box-shadow 0.14s ease-out,
    opacity 0.14s ease-out,
    background-color 0.14s ease-out;
}

/* 新粗野主义按压 = 位移 + 投影塌陷，像真的把纸上的按钮按下去 */
.btn-press {
  transform: translate(3rpx, 3rpx);
  box-shadow: 1rpx 1rpx 0 #111;
  opacity: 0.95;
}
.chip-press {
  transform: translate(2rpx, 2rpx);
  background: #ffe066;
  box-shadow: none;
}
.icon-press {
  transform: scale(0.88);
  opacity: 0.55;
}
.text-press {
  opacity: 0.5;
}
.done-press {
  transform: scale(0.85);
}
/* 行级与横幅反馈：整体变暗一档，不位移避免列表抖动 */
.row-press {
  opacity: 0.62;
}
/* 卡片按压：轻微下沉，保持投影色系 */
.card-press {
  transform: translate(2rpx, 2rpx) scale(0.99);
  opacity: 0.92;
}

/* Decorative sheet accent; dismissal uses existing close and backdrop controls. */
.sheet-handle {
  width: 88rpx;
  height: 10rpx;
  border-radius: 6rpx;
  background: #111;
  opacity: 0.16;
  margin: -6rpx auto 18rpx;
}

/* DDL 分区标题吸顶时加底部阴影，强化“悬浮层”感 */
.ddl-section-title {
  box-shadow: 0 6rpx 0 rgba(17, 17, 17, 0.06);
}

/* 空态更纸感：虚线描边 + 轻微倾斜印章感 */
.empty.card-paper {
  border-style: dashed;
  box-shadow: 6rpx 6rpx rgba(17, 17, 17, 0.14);
}

/* 低动效偏好：关闭按压过渡与入场动画 */
@media (prefers-reduced-motion: reduce) {
  .small-button,
  .chip,
  .filter,
  .primary,
  .icon-button,
  .text-button,
  .done-button,
  .category-button,
  .skin-home-change,
  .item-card,
  .skin-card,
  .nav-button,
  .nav-icon {
    transition: none !important;
  }
}

/* Keep the approved date/clock/verify row intact below the countdown. */
.page .ddl-item {
  height: calc(44px + 180rpx);
}
.page .ddl-time {
  flex-wrap: wrap;
  gap: 0 14rpx;
  min-height: calc(44px + 60rpx);
  flex: 0 0 calc(44px + 60rpx);
}
.page .ddl-time .ddl-countdown {
  box-sizing: border-box;
  flex: 0 0 100%;
  margin: 0;
  padding: 4rpx 14rpx;
  font-size: 32rpx;
  line-height: 1.25;
}
/* Literal px floor supplements rpx at narrow phone widths. */
.icon-button {
  min-width: 44px;
  min-height: 44px;
}
.nav-button {
  min-height: 48px;
}
