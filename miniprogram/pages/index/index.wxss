.completion-check {
  position: relative;
  width: 30rpx;
  height: 28rpx;
  pointer-events: none;
}
.check-short,
.check-long {
  position: absolute;
  height: 3rpx;
  border-radius: 2rpx;
  background: #111;
  transform-origin: left center;
}
.check-short {
  left: 3rpx;
  top: 11rpx;
  width: 11rpx;
  transform: rotate(45deg);
}
.check-long {
  left: 11rpx;
  top: 19rpx;
  width: 21rpx;
  transform: rotate(-45deg);
}
.is-checking .check-short {
  animation: check-short-draw 70ms ease-out both;
}
.is-checking .check-long {
  animation: check-long-draw 110ms 70ms ease-out both;
}
@keyframes check-short-draw {
  from {
    transform: rotate(45deg) scaleX(0);
  }
  to {
    transform: rotate(45deg) scaleX(1);
  }
}
@keyframes check-long-draw {
  from {
    transform: rotate(-45deg) scaleX(0);
  }
  to {
    transform: rotate(-45deg) scaleX(1);
  }
}
