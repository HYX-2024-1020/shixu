/* Generated from Windows skin-motion.css and desktop.css. Run mini:build. */
/* Shared by Windows and the generated WeChat stylesheet. */
.skin-mascot.skin-interacting .skin-spark {
  animation: skin-twinkle 0.75s ease-in-out infinite alternate;
}
.skin-body.skin-motion-bounce {
  animation: skin-bounce 0.55s ease-in-out infinite;
}
.skin-body.skin-motion-wiggle {
  animation: skin-wiggle 0.65s ease-in-out infinite;
}
.skin-body.skin-motion-spin {
  animation: skin-spin 1.4s ease-in-out infinite;
  transform-origin: center;
}
.skin-body.skin-motion-float {
  animation: skin-float 1.5s ease-in-out infinite;
}
@keyframes skin-bounce {
  0%,
  100% {
    transform: translateY(0) scale(1.04, 0.96);
  }
  50% {
    transform: translateY(-32rpx) scale(0.96, 1.04);
  }
}
@keyframes skin-wiggle {
  0%,
  100% {
    transform: rotate(-7deg);
  }
  50% {
    transform: rotate(7deg);
  }
}
@keyframes skin-spin {
  from {
    transform: rotate(0);
  }
  to {
    transform: rotate(360deg);
  }
}
@keyframes skin-float {
  0%,
  100% {
    transform: translateY(0) rotate(-3deg);
  }
  50% {
    transform: translateY(-34rpx) rotate(3deg);
  }
}
@keyframes skin-twinkle {
  from {
    opacity: 0.3;
    transform: scale(0.7);
  }
  to {
    opacity: 1;
    transform: scale(1.1);
  }
}
