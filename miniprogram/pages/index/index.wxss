/* ========== 第二轮：移动端手感进化（2026-10-26） ========== */

/* 按压反馈的统一过渡：只动 transform / shadow / opacity，不触发布局 */
.small-button,
.chip,
.filter,
.primary,
.icon-button,
.text-button,
.done-button,
.category-button,
.skin-home-change,
.item-card,
.skin-card,
.ddl-time,
.ddl-copy,
.ddl-subbar,
.update-banner {
  transition:
    transform 0.14s ease-out,
    box-shadow 0.14s ease-out,
    opacity 0.14s ease-out,
    background-color 0.14s ease-out;
}

/* 新粗野主义按压 = 位移 + 投影塌陷，像真的把纸上的按钮按下去 */
.btn-press {
  transform: translate(3rpx, 3rpx);
  box-shadow: 1rpx 1rpx 0 #111;
  opacity: 0.95;
}
.chip-press {
  transform: translate(2rpx, 2rpx);
  background: #ffe066;
  box-shadow: none;
}
.icon-press {
  transform: scale(0.88);
  opacity: 0.55;
}
.text-press {
  opacity: 0.5;
}
.done-press {
  transform: scale(0.85);
}
/* 行级与横幅反馈：整体变暗一档，不位移避免列表抖动 */
.row-press {
  opacity: 0.62;
}
/* 卡片按压：轻微下沉，保持投影色系 */
.card-press {
  transform: translate(2rpx, 2rpx) scale(0.99);
  opacity: 0.92;
}

/* Decorative sheet accent; dismissal uses existing close and backdrop controls. */
.sheet-handle {
  width: 88rpx;
  height: 10rpx;
  border-radius: 6rpx;
  background: #111;
  opacity: 0.16;
  margin: -6rpx auto 18rpx;
}

/* DDL 分区标题吸顶时加底部阴影，强化“悬浮层”感 */
.ddl-section-title {
  box-shadow: 0 6rpx 0 rgba(17, 17, 17, 0.06);
}

/* 空态更纸感：虚线描边 + 轻微倾斜印章感 */
.empty.card-paper {
  border-style: dashed;
  box-shadow: 6rpx 6rpx rgba(17, 17, 17, 0.14);
}

/* 低动效偏好：关闭按压过渡与入场动画 */
@media (prefers-reduced-motion: reduce) {
  .small-button,
  .chip,
  .filter,
  .primary,
  .icon-button,
  .text-button,
  .done-button,
  .category-button,
  .skin-home-change,
  .item-card,
  .skin-card,
  .nav-button,
  .nav-icon {
    transition: none !important;
  }
}

