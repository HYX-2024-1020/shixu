/* Small visual controls, full touch targets, and a quieter system type scale. */
.page,
.detail-sheet,
.drag-ghost {
  font-family:
    -apple-system, BlinkMacSystemFont, "SF Pro Text", "Helvetica Neue",
    "PingFang SC", "Microsoft YaHei", sans-serif;
