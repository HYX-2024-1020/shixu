@import "../../lib/generated/client-ui.wxss";
.page {
  padding: 36rpx 30rpx calc(180rpx + env(safe-area-inset-bottom));
}
.draft-file {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 18rpx;
  margin: 16rpx 0;
  border: 2rpx dashed #bbaa7b;
  border-radius: 6rpx;
  background: #fff;
  font-size: 25rpx;
  word-break: break-all;
}
.draft-file text {
  max-width: 100%;
}
.original-scrim {
  z-index: 40;
}
.heading,
.section-top,
.card-top,
.card-foot,
.editor-foot,
.capture-toolbar,
.world-heading,
.sync-line,
.capability {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.brand {
  display: flex;
  align-items: center;
  gap: 14rpx;
  font-size: 36rpx;
  font-weight: 900;
  flex-shrink: 0;
  white-space: nowrap;
}
.tagline {
  display: block;
  font-size: 23rpx;
  margin-top: 12rpx;
}
.header-actions {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
}
.small-button,
.chip,
.filter {
  background: #fff;
  border: 2rpx solid #111;
  border-radius: 6rpx;
  font-size: 24rpx;
  line-height: 1.5;
  padding: 14rpx 18rpx;
}
.selected,
.chip.selected {
  background: #ffd43b;
  box-shadow: 3rpx 3rpx 0 #111;
}
.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  margin: 46rpx 0 38rpx;
  text-align: center;
}
.hero-copy {
  flex: 1;
}
.hero-title {
  font-size: 80rpx;
  font-weight: 900;
  line-height: 1.2;
  letter-spacing: -1rpx;
  margin-bottom: 16rpx;
}
.line-break {
  display: block;
}
.bucket-drawing {
  position: relative;
  width: 340rpx;
  height: 340rpx;
  margin-top: 12rpx;
}
.mascot {
  display: block;
  width: 340rpx;
  height: 340rpx;
  filter: drop-shadow(8rpx 8rpx 0 #7048e833);
}
.bucket-word {
  position: absolute;
  bottom: 14rpx;
  left: 0;
  width: 100%;
  text-align: center;
  font-size: 12rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}
.skin-bubble {
  position: absolute;
  left: 46%;
  top: -12rpx;
  min-width: 190rpx;
  max-width: 280rpx;
  padding: 10rpx 16rpx;
  background: #fff;
  border: 4rpx solid #111;
  border-radius: 6rpx;
  box-shadow: 6rpx 6rpx #111;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.5;
  transform: rotate(2deg);
}
.editor,
.card-paper {
  background: #fff;
  border: 4rpx solid #111;
  border-radius: 6rpx;
  padding: 24rpx;
  box-shadow: 8rpx 8rpx #111;
}
.card-paper {
  margin: 24rpx 0;
}
.editor textarea {
  width: 100%;
  min-height: 120rpx;
  max-height: 500rpx;
  line-height: 1.8;
}
.editor-foot {
  font-size: 21rpx;
  color: #777061;
  margin-top: 28rpx;
}
.capture-toolbar {
  margin-top: 26rpx;
}
.primary {
  background: #ffd43b;
  border: 3rpx solid #111;
  box-shadow: 5rpx 5rpx 0 #111;
  font-weight: 800;
  line-height: 1.6;
  padding: 18rpx 28rpx;
  font-size: 30rpx;
}
.capture-toolbar .primary {
  flex-shrink: 0;
}
.text-button {
  padding: 8rpx 0;
  background: transparent;
  color: #534b38;
  font-size: 25rpx;
  line-height: 1.6;
}
.quiet {
  display: block;
  font-size: 23rpx;
  color: #777061;
  line-height: 1.8;
}
.delivery-heading {
  margin-top: 52rpx;
}
.section-title {
  font-size: 42rpx;
  font-weight: 900;
  display: block;
}
.eyebrow {
  display: block;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  color: #777061;
  margin-bottom: 10rpx;
}
.empty {
  text-align: center;
  line-height: 1.9;
  color: #777061;
  font-size: 26rpx;
  padding: 44rpx 28rpx;
}
.empty-title {
  display: block;
  color: #111;
  font-size: 30rpx;
  font-weight: 800;
  margin-bottom: 12rpx;
}
.world-heading {
  margin: 42rpx 0 28rpx;
  justify-content: flex-start;
  gap: 24rpx;
}
.world-mascot {
  order: -1;
  width: 150rpx;
  height: 150rpx;
  flex-shrink: 0;
  filter: drop-shadow(5rpx 5rpx 0 #7048e833);
}
.search-box {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 24rpx;
  background: #fff;
  border: 2rpx solid #111;
  border-radius: 6rpx;
}
.search-box input {
  border: 0;
  flex: 1;
  background: transparent;
  padding: 0;
  height: 86rpx;
  min-width: 0;
}
.scope-tabs,
.filter-bar,
.button-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 14rpx;
  margin: 24rpx 0;
}
.chip {
  border-radius: 6rpx;
}
.filter-bar {
  gap: 12rpx;
}
.filter {
  font-size: 22rpx;
  padding: 12rpx 14rpx;
}
.group-strip {
  white-space: nowrap;
  margin: 20rpx 0;
  width: 100%;
}
.group-strip .chip {
  display: inline-block;
  margin-right: 12rpx;
}
.sync-line {
  font-size: 21rpx;
  color: #777061;
  margin: 26rpx 0;
}
.item-card {
  border: 4rpx solid #111;
  border-radius: 6rpx;
  background: #fff;
  box-shadow: 8rpx 8rpx #ffd43b;
  margin: 0 8rpx 30rpx 0;
  padding: 28rpx;
  animation: card-in 0.22s ease-out;
}
.kind-label {
  font-size: 23rpx;
  font-weight: 700;
}
.item-title {
  display: block;
  font-size: 35rpx;
  line-height: 1.5;
  font-weight: 900;
  margin: 12rpx 0;
  word-break: break-all;
}
.item-summary {
  display: block;
  font-size: 27rpx;
  line-height: 1.8;
  color: #625e51;
  white-space: pre-wrap;
}
.card-meta {
  display: flex;
  gap: 14rpx;
  flex-wrap: wrap;
  margin: 22rpx 0;
  font-size: 23rpx;
  color: #625e51;
}
.card-foot {
  padding-top: 18rpx;
  border-top: 2rpx solid rgba(41, 40, 34, 0.12);
  font-size: 21rpx;
  color: #716c5c;
}
.card-actions {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.icon-button {
  background: transparent;
  padding: 0 10rpx;
  line-height: 50rpx;
  font-size: 42rpx;
  color: #111;
  min-width: 50rpx;
}
.starred {
  color: #9b6800;
}
.done-button[size="mini"] {
  box-sizing: border-box;
  display: inline-flex;
  flex: 0 0 64rpx;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  min-width: 64rpx;
  max-width: 64rpx;
  height: 64rpx;
  min-height: 64rpx;
  max-height: 64rpx;
  border: 3rpx solid #111;
  border-radius: 50%;
  padding: 0;
  background: transparent;
  line-height: 40rpx;
  font-size: 30rpx;
}
.done-button.checked {
  background: #ffd43b;
  color: #111;
}
.completion-check {
  position: relative;
  width: 30rpx;
  height: 28rpx;
  pointer-events: none;
}
.check-short,
.check-long {
  position: absolute;
  height: 3rpx;
  border-radius: 2rpx;
  background: #111;
  transform-origin: left center;
}
.check-short {
  left: 3rpx;
  top: 11rpx;
  width: 11rpx;
  transform: rotate(45deg);
}
.check-long {
  left: 11rpx;
  top: 19rpx;
  width: 21rpx;
  transform: rotate(-45deg);
}
.is-checking .check-short {
  animation: check-short-draw 70ms ease-out both;
}
.is-checking .check-long {
  animation: check-long-draw 110ms 70ms ease-out both;
}
@keyframes check-short-draw {
  from {
    transform: rotate(45deg) scaleX(0);
  }
  to {
    transform: rotate(45deg) scaleX(1);
  }
}
@keyframes check-long-draw {
  from {
    transform: rotate(-45deg) scaleX(0);
  }
  to {
    transform: rotate(-45deg) scaleX(1);
  }
}
.done-card {
  opacity: 0.78;
}
.group-title {
  display: block;
  font-size: 29rpx;
  font-weight: 800;
  margin: 28rpx 0 18rpx;
}
.badge {
  display: inline-block;
  font-size: 21rpx;
  padding: 6rpx 12rpx;
  background: #f0e7bd;
  border: 1rpx solid #c5b988;
  border-radius: 8rpx;
}
.source-preview {
  display: block;
  font-size: 27rpx;
  line-height: 1.9;
  white-space: pre-wrap;
  word-break: break-all;
  margin: 20rpx 0;
}
.card-title {
  font-weight: 800;
  font-size: 30rpx;
}
.notice,
.error,
.update-banner {
  padding: 18rpx 22rpx;
  border-radius: 6rpx;
  font-size: 25rpx;
  line-height: 1.7;
  margin: 24rpx 0;
  word-break: break-all;
}
.notice {
  background: #e6edce;
}
.error {
  background: #f8dad0;
  border: 2rpx solid #9d4934;
}
.update-banner {
  background: #ffd43b;
  border: 2rpx solid #111;
}
.settings {
  margin-top: 48rpx;
}
.settings-copy {
  display: block;
  font-size: 25rpx;
  color: #777061;
  line-height: 1.9;
  margin: 20rpx 0;
}
.field-label {
  display: block;
  font-size: 26rpx;
  margin: 26rpx 0 14rpx;
}
.subheading {
  display: block;
  font-size: 31rpx;
  font-weight: 800;
  line-height: 1.6;
}
input {
  width: 100%;
  height: 88rpx;
  background: #fff;
  border: 2rpx solid #111;
  border-radius: 6rpx;
  padding: 0 20rpx;
}
.settings .primary {
  margin-top: 26rpx;
}
.about {
  display: block;
  font-size: 22rpx;
  color: #777061;
  margin: 44rpx 0;
}
.capability {
  font-size: 25rpx;
  border-bottom: 1rpx solid #d4cbb1;
  padding: 20rpx 0;
}
.bottom-nav {
  position: fixed;
  z-index: 5;
  left: 12%;
  right: 12%;
  bottom: calc(14rpx + env(safe-area-inset-bottom));
  display: flex;
  background: #111;
  border: 4rpx solid #111;
  border-radius: 6rpx;
  padding: 10rpx;
  box-shadow: 8rpx 8rpx #1114;
}
.nav-button {
  flex: 1;
  background: transparent;
  color: #fff;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 76rpx;
  border-radius: 6rpx;
}
.nav-button.active {
  background: #ffd43b;
  color: #111;
}
.scrim {
  position: fixed;
  z-index: 20;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(35, 33, 29, 0.35);
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.sheet {
  width: 100%;
  max-height: 90vh;
  background: #fff9e6;
  border: 3rpx solid #111;
  border-bottom: 0;
  border-radius: 28rpx 28rpx 0 0;
  padding: 28rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  animation: sheet-in 0.24s ease-out;
}
.sheet-scroll {
  height: 69vh;
  margin-top: 18rpx;
}
.detail-scrim {
  z-index: 30;
}
.detail-sheet {
  background: #fff;
}
.detail-title {
  display: block;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.5;
  margin: 12rpx 0 20rpx;
}
.detail-summary,
.detail-line {
  display: block;
  font-size: 28rpx;
  line-height: 1.9;
  white-space: pre-wrap;
  word-break: break-all;
}
.detail-section {
  padding-top: 28rpx;
  margin-top: 30rpx;
  border-top: 2rpx dashed #c9bfa7;
}
.detail-section .subheading {
  margin-bottom: 18rpx;
}
.evidence {
  padding: 20rpx;
  background: rgba(222, 213, 184, 0.3);
  border-left: 5rpx solid #c1ab6d;
  margin: 16rpx 0;
}
.due-label {
  display: inline-block;
  background: #ffd43b;
  padding: 12rpx;
  border-radius: 10rpx;
  margin-top: 16rpx;
  font-size: 26rpx;
}
.edit-area {
  box-sizing: border-box;
  min-height: 160rpx;
  width: 100%;
  padding: 18rpx;
  border: 2rpx solid #111;
  background: #fff;
  border-radius: 6rpx;
  font-size: 28rpx;
  line-height: 1.8;
  margin: 18rpx 0;
}
.danger {
  color: #994532;
}
.more-button {
  margin: 30rpx auto;
}
.skin-scrim {
  z-index: 35;
}
.skin-preview {
  border: 3rpx solid #111;
  border-radius: 6rpx;
  padding: 26rpx;
  text-align: center;
  box-shadow: 6rpx 6rpx 0 #111;
  margin: 14rpx 6rpx 32rpx 0;
}
.preview-art {
  display: block;
  width: 280rpx;
  height: 280rpx;
  margin: auto;
}
.skin-preview .button-row {
  justify-content: center;
}
.skin-preview .primary {
  font-size: 25rpx;
  padding: 15rpx 20rpx;
}
.skin-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
  padding: 4rpx;
}
.skin-card {
  border: 2rpx solid #111;
  border-radius: 6rpx;
  padding: 16rpx;
  text-align: center;
}
.skin-card.selected {
  outline: 5rpx solid #e3ba32;
  outline-offset: 2rpx;
}
.skin-card image {
  width: 100%;
  height: 180rpx;
}
.skin-name {
  display: block;
  font-weight: 800;
  font-size: 28rpx;
}
.skin-card .quiet {
  font-size: 21rpx;
}
.skin-card .button-row {
  justify-content: center;
  margin: 10rpx 0;
}
.current-delivery {
  margin: 24rpx 0;
}
.current-delivery .item-card {
  margin-top: 24rpx;
}
.job-strip {
  padding: 0 30rpx 180rpx;
}
.job-line {
  padding: 20rpx;
  margin: 16rpx 0;
  background: #e6edce;
  border: 2rpx solid #111;
  border-radius: 6rpx;
  font-size: 24rpx;
  line-height: 1.8;
}
.job-line text {
  display: block;
}
@keyframes card-in {
  from {
    transform: translateY(8rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}
@keyframes sheet-in {
  from {
    transform: translateY(30rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.brand-mark {
  width: 58rpx;
  height: 58rpx;
  line-height: 58rpx;
  text-align: center;
  background: #ffd43b;
  border: 4rpx solid #111;
  border-radius: 6rpx;
  box-shadow: 5rpx 5rpx #111;
}
.brand-en {
  font-size: 16rpx;
  letter-spacing: 2rpx;
  color: #8a866e;
}
.header-actions .small-button {
  width: 128rpx;
  box-sizing: border-box;
  white-space: nowrap;
  font-size: 21rpx;
  padding: 12rpx;
  font-weight: 800;
  box-shadow: 4rpx 4rpx #111;
}
.market-button {
  background: #e5dbff;
}
.hero-highlight {
  display: inline-block;
  background: #ffd43b;
  border: 4rpx solid #111;
  border-radius: 6rpx;
  padding: 0 10rpx;
  box-shadow: 7rpx 7rpx #111;
}
.skin-home-change {
  width: 320rpx;
  font-size: 22rpx;
  font-weight: 800;
  background: #fff9e6;
  border: 3rpx solid #111;
  border-radius: 6rpx;
  padding: 8rpx 18rpx;
  line-height: 1.6;
  box-shadow: 4rpx 4rpx #111;
}
.count-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 27rpx;
  font-weight: 800;
  margin-top: 8rpx;
}
.count-badge,
.nav-badge {
  display: inline-block;
  background: #7048e8;
  color: #fff;
  border-radius: 5rpx;
  padding: 0 14rpx;
  font-weight: 900;
}
.count-badge {
  border: 4rpx solid #111;
  font-size: 38rpx;
  line-height: 1.5;
  box-shadow: 4rpx 4rpx #111;
}
.nav-badge {
  font-size: 22rpx;
  line-height: 36rpx;
  margin-left: 10rpx;
}
.world-title {
  display: block;
  font-size: 49rpx;
  font-weight: 900;
  line-height: 1.5;
  margin-bottom: 14rpx;
}

@media (max-width: 350px) {
  .brand-en {
    display: none;
  }
  .hero-title {
    font-size: 74rpx;
  }
}

.small-button,
.text-button,
.primary {
  width: auto;
}

.scope-tabs .chip {
  width: 22%;
  min-width: 0;
  padding: 14rpx 4rpx;
}
.button-row .small-button {
  width: auto;
  min-width: 0;
}
.ai-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 12rpx 0;
  font-size: 24rpx;
}
.ai-entry text {
  flex: 1;
}
.ai-entry button {
  flex-shrink: 0;
}
.ai-guide {
  border-top: 2rpx solid #211f20;
  margin-top: 20rpx;
}

.ddl-workspace {
  padding-top: 30rpx;
}
.ddl-head {
  display: flex;
  gap: 24rpx;
  align-items: center;
  margin-bottom: 30rpx;
}
.ddl-head image {
  width: 130rpx;
  height: 140rpx;
  flex-shrink: 0;
}
.ddl-head .world-title {
  font-size: 44rpx;
}
.ddl-head .quiet {
  display: block;
  margin-top: 18rpx;
}
.ddl-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin: 30rpx 0;
}
.ddl-stats text {
  background: #fff;
  border: 4rpx solid #111;
  padding: 12rpx;
  font-size: 23rpx;
  box-shadow: 6rpx 6rpx #ffd43b;
}
.ddl-stats text:nth-child(2) {
  box-shadow: 6rpx 6rpx #7048e8;
}
.ddl-timeline {
  background: white;
  border: 5rpx solid #111;
  box-shadow: 8rpx 8rpx #7048e8;
  padding: 24rpx;
  margin: 30rpx 0;
}
.ddl-timeline .subheading {
  font-size: 27rpx;
}
.ddl-stops {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
}
.ddl-subbar {
  border: 5rpx solid #111;
  background: #fff;
  padding: 22rpx;
  font-weight: 800;
  margin: 30rpx 0;
  font-size: 28rpx;
}
.ddl-subbar.overdue {
  background: #ffe5ee;
}
.ddl-section-title {
  font-size: 31rpx;
  font-weight: 900;
  border-bottom: 4rpx solid #111;
  padding: 18rpx 0;
  margin-top: 30rpx;
}
.ddl-item {
  border: 5rpx solid #111;
  background: #fff;
  box-shadow: 7rpx 7rpx #111;
  margin: 26rpx 0;
  border-radius: 6rpx;
  overflow: hidden;
}
.ddl-time {
  background: #fff9e6;
  border-bottom: 5rpx solid #111;
  padding: 18rpx;
  display: flex;
  gap: 18rpx;
  flex-wrap: wrap;
  align-items: center;
  font-size: 23rpx;
}
.ddl-time text:last-child {
  color: #7048e8;
  margin-left: auto;
  font-size: 21rpx;
}
.ddl-clock {
  font-weight: 900;
  font-size: 31rpx;
}
.ddl-row {
  display: flex;
  align-items: flex-start;
  padding: 22rpx;
  gap: 20rpx;
}
.ddl-row .done-button {
  flex: none;
  margin: 0;
}
.ddl-copy {
  flex: 1;
  min-width: 0;
}
.ddl-copy .item-title {
  font-size: 29rpx;
}
.ddl-copy .quiet {
  font-size: 22rpx;
}
.ddl-course {
  background: #eee8ff;
  border: 3rpx solid #111;
  font-size: 22rpx;
  padding: 3rpx 10rpx;
  display: inline-block;
  margin: 12rpx 0;
}
.ddl-empty {
  padding: 40rpx;
  text-align: center;
  color: #777;
  border: 3rpx dashed #999;
  margin: 30rpx 0;
}
.ddl-add {
  padding: 24rpx;
  border: 4rpx solid #111;
  background: #fff;
}
.ddl-add textarea {
  width: 100%;
  height: 150rpx;
}
.nav-button {
  min-width: 0;
  padding-left: 20rpx;
  padding-right: 20rpx;
}

/* Reserve the dock outside the scrollable content, including iPhone safe area. */
page {
  height: 100%;
  overflow: hidden;
}
.workspace-scroll {
  height: calc(100vh - 180rpx - env(safe-area-inset-bottom));
}
.page {
  padding-bottom: 36rpx;
}
.ddl-slider {
  position: relative;
  height: 84rpx;
  margin: 20rpx 0 8rpx;
}
.ddl-slider-rail {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  top: 36rpx;
  height: 14rpx;
  border: 4rpx solid #111;
  border-radius: 5rpx;
  background: #fff9e6;
  pointer-events: none;
}
.ddl-slider-square {
  position: absolute;
  top: 50%;
  width: 56rpx;
  height: 56rpx;
  box-sizing: border-box;
  border: 5rpx solid #111;
  border-radius: 6rpx;
  background: #ffd43b;
  box-shadow: 5rpx 5rpx #111;
  transform: translate(-50%, -50%);
}
.ddl-native-slider {
  position: absolute;
  inset: 0;
  opacity: 0;
  margin: 0;
}
.ddl-stops .selected {
  background: #ffd43b;
  color: #111;
  border: 3rpx solid #111;
}
.ddl-stops text {
  padding: 6rpx 10rpx;
}
.done-button.is-checking {
  background: #ffd43b;
  animation: check-pop 230ms ease-out;
}
.is-leaving {
  animation: card-leave 170ms ease-in forwards;
}
@keyframes check-pop {
  0% {
    transform: scale(0.8);
  }
  55% {
    transform: scale(1.2);
  }
  100% {
    transform: scale(1);
  }
}
@keyframes card-leave {
  to {
    opacity: 0;
    transform: translateY(-8rpx) scale(0.96);
  }
}

/* Native layout adapters; artwork, motion and card visuals come from Windows. */
.skin-mascot {
  position: relative;
}
.skin-body {
  transform-origin: 50% 83%;
}
.skin-spark {
  position: absolute;
  opacity: 0;
  pointer-events: none;
  color: #7048e8;
  font-size: 56rpx;
}
.skin-spark-one {
  top: 20%;
  left: 4%;
}
.skin-spark-two {
  right: 2%;
  bottom: 14%;
  color: #cf762c;
  font-size: 70rpx;
}
.skin-preview-stage {
  position: relative;
  margin: 30rpx auto;
  padding-top: 36rpx;
}
.skin-preview-stage .skin-bubble {
  left: 50%;
  transform: translateX(-50%) rotate(-2deg);
  width: max-content;
  max-width: 90%;
}
.skin-bubble::after {
  content: "";
  position: absolute;
  bottom: -12rpx;
  left: 32rpx;
  width: 18rpx;
  height: 18rpx;
  background: #fff;
  border-right: 4rpx solid #111;
  border-bottom: 4rpx solid #111;
  transform: rotate(45deg);
}
.world-heading > view {
  min-width: 0;
}
.world .world-title {
  font-size: 66rpx;
  line-height: 1.2;
}
.world-records {
  margin: 20rpx 0;
}
.world-records button {
  display: inline-block;
}
.item-card .card-top {
  justify-content: flex-start;
  margin-bottom: 24rpx;
}
.item-card .card-top .kind-label {
  flex: 1;
}
.item-card .card-top .done-button {
  margin-right: 8rpx;
}
.item-card .card-meta > text:first-child:not(:empty) {
  border: 4rpx solid #111;
  border-radius: 8rpx;
  padding: 4rpx 10rpx;
  color: #111;
  background: #fff4bd;
  box-shadow: 4rpx 4rpx #111;
}
.item-card .card-foot {
  flex-wrap: wrap;
}
.item-card .card-foot > text {
  flex: 1;
  min-width: 200rpx;
  color: #7048e8;
}
@media (min-width: 600px) {
  .page {
    max-width: 1100px;
    margin: auto;
  }
}
@media (prefers-reduced-motion: reduce) {
  .skin-mascot .skin-body,
  .skin-mascot .skin-spark {
    animation: none !important;
  }
}

.category-nav {
  white-space: nowrap;
  width: 100%;
  margin: 24rpx 0;
  padding-bottom: 10rpx;
}
.category-button {
  display: inline-block;
  margin-right: 14rpx;
