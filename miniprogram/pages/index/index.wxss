}
.page .world .item-card .card-source-link {
  min-height: 44px;
}
.page .ddl-row .compact-delete {
  min-width: 44px;
}
/* Phone dialog follows the Windows paper, border, close target and action hierarchy. */
.detail-scrim {
  align-items: center;
  padding: 24rpx;
  box-sizing: border-box;
}
.detail-sheet {
  width: 100%;
  max-width: 820px;
  height: 82vh;
  max-height: 82vh;
  padding: 24rpx;
  border: 4rpx solid #111;
  border-radius: 8rpx;
  box-shadow: 8rpx 8rpx #111;
  background: #fffdf5;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.detail-toolbar {
  flex: 0 0 auto;
  min-height: 44px;
  gap: 16rpx;
}
.detail-toolbar .kind-label {
  flex: 1;
  min-width: 0;
  overflow-wrap: anywhere;
  line-height: 1.5;
}
.detail-close {
  flex: 0 0 44px;
  width: 44px;
  min-width: 44px;
  height: 44px;
  min-height: 44px;
  padding: 0;
  line-height: 40px;
  border: 2px solid #111;
  border-radius: 3px;
  background: #ffd43b;
  margin: 0 0 0 auto;
}
.detail-sheet .sheet-scroll {
  height: 0;
  flex: 1;
  min-height: 0;
  width: 100%;
  margin-top: 16rpx;
}
.detail-sheet .detail-title {
  margin: 10rpx 0 18rpx;
  font-size: 38rpx;
  line-height: 1.4;
  overflow-wrap: anywhere;
}
.detail-sheet .due-label {
  max-width: 100%;
  box-sizing: border-box;
  border: 2rpx solid #111;
  border-radius: 4rpx;
  background: #fff2bd;
