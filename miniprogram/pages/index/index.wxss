.page { padding: 32rpx 32rpx calc(160rpx + env(safe-area-inset-bottom)); }
.heading, .card-top, .card-foot, .editor-foot, .section-top, .sync-line { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.brand { font-size: 58rpx; font-weight: 900; display: block; }
.tagline { display: block; font-size: 24rpx; margin-top: 8rpx; }
.settings-button { background: transparent; border: 3rpx solid #292822; padding: 0 22rpx; line-height: 64rpx; flex-shrink: 0; }
.preview-note { font-size: 22rpx; color: #716c5c; margin: 32rpx 0; line-height: 1.6; }
.hero { display: flex; align-items: center; justify-content: center; gap: 24rpx; margin: 64rpx 0; }
.mascot { width: 220rpx; height: 180rpx; flex-shrink: 0; }
.speech { font-size: 40rpx; font-weight: 800; line-height: 1.6; }
.line-break { display: block; }
.editor { background: #fffdf5; border: 3rpx solid #292822; border-radius: 24rpx; padding: 28rpx; box-shadow: 8rpx 8rpx 0 #d8c691; }
textarea { width: 100%; min-height: 240rpx; max-height: 600rpx; line-height: 1.8; }
.editor-foot { font-size: 22rpx; color: #716c5c; margin-top: 24rpx; }
.primary { margin-top: 28rpx; background: #ffe35b; border: 3rpx solid #292822; box-shadow: 6rpx 6rpx 0 #c1a7cd; font-weight: 800; line-height: 92rpx; }
.text-button { padding: 8rpx 0; background: transparent; color: #534b38; font-size: 25rpx; line-height: 1.6; }
.capture > .text-button { margin: 36rpx 0; }
.notice, .error, .update-banner { padding: 20rpx 24rpx; border-radius: 16rpx; font-size: 26rpx; line-height: 1.7; margin: 24rpx 0; }
.notice { background: #e6edce; }
.error { background: #f8dad0; border: 2rpx solid #9d4934; word-break: break-all; }
.update-banner { background: #ffe35b; border: 2rpx solid #292822; }
.section-title { font-size: 44rpx; font-weight: 900; display: block; }
.sync-line { font-size: 23rpx; color: #716c5c; margin-bottom: 28rpx; }
.empty { margin: 80rpx 24rpx; line-height: 1.8; color: #716c5c; text-align: center; }
.card { background: #fffdf5; border: 3rpx solid #292822; border-radius: 22rpx; padding: 28rpx; box-shadow: 6rpx 6rpx 0 #b5ced1; margin-bottom: 28rpx; }
.conflict-card { box-shadow: 6rpx 6rpx 0 #e5ac92; }
.card-top { align-items: flex-start; }
.card-title { font-size: 32rpx; font-weight: 800; word-break: break-all; }
.badge { font-size: 21rpx; white-space: nowrap; padding: 5rpx 10rpx; background: #f0e7bd; border-radius: 8rpx; }
.card-text { font-size: 28rpx; color: #625e51; margin: 22rpx 0; line-height: 1.8; white-space: pre-wrap; word-break: break-all; display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }
.card-text.expanded { display: block; }
.card-foot { font-size: 23rpx; color: #716c5c; }
.settings-copy { font-size: 27rpx; color: #716c5c; line-height: 1.9; margin: 24rpx 0; }
.field-label { font-size: 27rpx; margin: 36rpx 0 16rpx; }
input { width: 100%; height: 96rpx; background: #fffdf5; border: 3rpx solid #292822; border-radius: 16rpx; padding: 0 22rpx; }
.about { font-size: 23rpx; color: #716c5c; margin-top: 56rpx; }
.bottom-nav { position: fixed; left: 24rpx; right: 24rpx; bottom: calc(16rpx + env(safe-area-inset-bottom)); display: flex; background: #fffdf5; border: 3rpx solid #292822; border-radius: 22rpx; padding: 10rpx; box-shadow: 5rpx 5rpx 0 #b5ced1; }
.nav-button { flex: 1; background: transparent; font-size: 32rpx; font-weight: 800; line-height: 76rpx; }
.nav-button.active { background: #ffe35b; }
