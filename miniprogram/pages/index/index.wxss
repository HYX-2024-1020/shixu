}
.filter-done {
  min-height: 88rpx;
  margin-top: 24rpx;
  background: #111;
  color: #fff;
  font-size: 28rpx;
}
.skin-body {
  display: block;
}
.item-card .icon-button {
  min-width: 88rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
/* Native compact phone layouts. Keep desktop-derived artwork and hard shadows. */
.drag-help {
