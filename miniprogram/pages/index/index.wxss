  gap: 24rpx;
  margin: 24rpx 0;
}
.scope-picker {
  flex: 1;
  min-width: 0;
}
.scope-control,
.filter-trigger {
  box-sizing: border-box;
  min-height: 96rpx;
  border: 4rpx solid #111;
  border-radius: 8rpx;
  background: #fff;
  font-size: 28rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.filter-trigger {
