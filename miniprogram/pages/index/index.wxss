/* ========== 第三轮：卡片文字排版（2026-10-26） ========== */

/*
 * 卡片是"扫一眼"的预览，详情抽屉才是读全文的地方。
 * 列表卡片统一收敛行数（超出省略号），max-height 为 line-clamp 的降级兜底。
 * 详情抽屉 / 投递记录弹窗内的同名类不受影响，始终显示全文。
 */
.item-card .item-title,
.ddl-copy .item-title {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  max-height: 3em;
}
.item-card .item-summary {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
  max-height: 5.25em;
}
.ddl-copy .item-summary {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  max-height: 3.5em;
}
/* 投喂后的原文预览最长，收敛到 5 行，完整原文永远在"点开/投递记录"里 */
.current-delivery .source-preview {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 5;
  overflow: hidden;
  max-height: 9.5em;
}
/* 整理完成后投递卡片里的 AI 摘要同样收敛，避免一张卡占满整屏 */
.current-delivery > .card-paper > .item-summary {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 4;
  overflow: hidden;
  max-height: 7em;
}

/* Capture-result cards use the same type hierarchy with a little more reading room. */
.page .current-delivery .item-card .item-title {
  margin: 0;
  font-size: 30rpx;
  line-height: 1.4;
  max-height: 2.8em;
  font-weight: 600;
}
