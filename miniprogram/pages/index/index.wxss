.page .world .item-card .done-button,
.page .ddl-row .done-button {
  border: 0;
  background: transparent;
  border-radius: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.completion-orbit {
  width: 22px;
  height: 22px;
  box-sizing: border-box;
  border: 1.5px solid #655f50;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  transition:
    background-color 160ms,
    border-color 160ms;
}
.done-button.checked .completion-orbit,
.done-button.is-checking .completion-orbit {
  background: #ffd43b;
  border-color: #111;
}
.done-button.is-checking .completion-orbit {
  animation: orbit-settle 220ms cubic-bezier(0.2, 0.8, 0.2, 1.15) both;
}
@keyframes orbit-settle {
  0% {
    transform: scale(0.86);
  }
  65% {
    transform: scale(1.12);
  }
  100% {
    transform: scale(1);
  }
}
.page .world .item-card .pin-label {
  color: #7048e8;
  font-weight: 600;
}
.page .world .item-card.drag-card,
.page .ddl-workspace .ddl-item.drag-card {
  transition:
    transform 220ms cubic-bezier(0.22, 1, 0.36, 1),
    opacity 180ms ease;
}
.drag-ghost {
  max-height: none;
  display: flex;
  flex-direction: column;
  padding: 18rpx;
  transform: scale(1.025);
  border-radius: 6rpx;
  animation: drag-lift 180ms cubic-bezier(0.22, 1, 0.36, 1);
  box-shadow:
    8rpx 8rpx #7048e8,
    0 12rpx 32rpx #1112;
}
.drag-ghost-title {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
}
.drag-ghost-summary {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  font-size: 24rpx;
  font-weight: 400;
  color: #6d685b;
  margin-top: 12rpx;
}
@keyframes drag-lift {
  from {
    transform: scale(1);
  }
  to {
    transform: scale(1.025);
  }
}
.drag-ghost.is-settling {
  animation: none;
  transform: scale(1);
  opacity: 0;
  transition:
    left 240ms cubic-bezier(0.22, 1, 0.36, 1),
    top 240ms cubic-bezier(0.22, 1, 0.36, 1),
    width 240ms,
    height 240ms,
    transform 240ms,
    opacity 100ms 150ms;
}
@media (prefers-reduced-motion: reduce) {
  .drag-card,
  .drag-ghost,
  .completion-orbit {
    animation: none;
    transition: none;
  }
}
