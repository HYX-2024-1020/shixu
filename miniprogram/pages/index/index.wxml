    ><scroll-view scroll-y class="sheet-scroll"
      ><view class="button-row"><button hover-class="btn-press" class="small-button" data-step="-1" bindtap="recordPage" disabled="{{recordPage === 0}}">上一页</button><text class="quiet">第 {{recordPage + 1}} 页 · {{recordTotal}} 次投递</text><button hover-class="btn-press" class="small-button" data-step="1" bindtap="recordPage" disabled="{{(recordPage + 1) * 30 >= recordTotal}}">下一页</button></view><view wx:if="{{!rows.length}}" class="empty">这里还没有投递。</view
      ><view wx:for="{{rows}}" wx:key="id" class="card-paper"
        ><view class="card-top"
          ><text class="card-title">{{item.title}}</text
          ><text class="badge"
            >{{localMode ? '本机保存' : item.state}}</text
          ></view
        ><text wx:if="{{item.body}}" class="source-preview" selectable>{{item.body}}</text
        ><template wx:for="{{item.attachments}}" wx:for-item="file" wx:key="id" is="attachmentActions" data="{{file, packet: item.id, disabled: filesBusy || item.deleted}}"/><text class="quiet">{{item.date}}</text
        ><template wx:if="{{!item.deleted}}" is="deliveryJob" data="{{job: item.organizeJob, jobLabels, jobBusy, submitting: organizingPacketId === item.id, hasCards: item.hasResult}}"/><view class="button-row"
          ><button
            wx:if="{{item.conflict}}"
            hover-class="btn-press" class="small-button"
            data-id="{{item.id}}"
            bindtap="resolveConflict"
          >
            处理冲突</button
          ><block wx:elif="{{item.deleted}}"
            ><button
              hover-class="btn-press" class="small-button"
              data-id="{{item.id}}"
              bindtap="restore"
            >
              恢复投递</button
            ><button
              hover-class="text-press" class="text-button danger"
              data-id="{{item.id}}"
              bindtap="purgePacket"
            >
              永久删除
            </button></block
          ><block wx:else
            ><button wx:if="{{item.hasResult}}" class="small-button" data-id="{{item.id}}" bindtap="showDelivery" hover-class="btn-press">查看卡片</button><button
              wx:if="{{(!item.organizeJob && !item.hasResult) || item.organizeJob.retryable}}"
              hover-class="btn-press" class="small-button"
              data-id="{{item.id}}"
              bindtap="organizeRecord"
              disabled="{{jobBusy}}"
            >
              AI 整理</button
            ><button
              hover-class="btn-press" class="small-button"
              data-id="{{item.id}}"
              bindtap="createManual"
            >
              手动记成事项</button
            ><button
              hover-class="text-press" class="text-button danger"
              data-id="{{item.id}}"
              bindtap="remove"
            >
              删除整次投递
            </button></block
          ></view
        ></view
      ></scroll-view
    ></view
  ></view
>
<view wx:if="{{selected}}" class="scrim detail-scrim" bindtap="closeItem"
  ><view class="sheet detail-sheet kind-{{selected.item.kind}}" catchtap="stopTap"
    ><view class="sheet-handle"></view><view class="section-top detail-toolbar"
      ><view class="detail-heading"><text class="detail-kind">{{selected.kindLabel}}</text><text class="detail-group">{{selected.group}}</text></view><button class="icon-button detail-close" aria-label="关闭事项详情" bindtap="closeItem" hover-class="icon-press" hover-stop-propagation="{{true}}">×</button></view
    ><view wx:if="{{error || notice}}" class="detail-feedback"><view wx:if="{{error}}" class="error" selectable>{{error}}</view><view wx:if="{{notice}}" class="notice">{{notice}}</view></view><scroll-view scroll-y class="sheet-scroll" scroll-into-view="{{detailAnchor}}" scroll-top="{{detailScrollTop}}">
      <block wx:if="{{editing}}"
        ><view class="field-label">标题</view
        ><input
          value="{{editTitle}}"
          data-field="editTitle"
          bindinput="onEdit"
          maxlength="150"
        /><view class="field-label">总结</view
        ><textarea
          class="edit-area"
          value="{{editSummary}}"
          data-field="editSummary"
          bindinput="onEdit"
          maxlength="2000"
        /><view class="field-label">类型</view
        ><picker
          range="{{editKinds}}"
          value="{{editKind}}"
          bindchange="onEditKind"
          ><view hover-class="chip-press" class="filter">{{editKinds[editKind]}} ▾</view></picker
        ><view class="field-label">分组（留空拆出分组）</view
        ><input
          value="{{editGroup}}"
          data-field="editGroup"
          bindinput="onEdit"
          maxlength="150"
        /><view wx:if="{{selected.evidence.length}}" class="detail-section"><text class="subheading">时间依据 · 原文</text><text wx:if="{{selected.item.due.dateInferred}}" class="detail-line">日期依据：{{selected.item.due.dateReason}}</text><text wx:if="{{selected.clockInfo.timeInferred}}" class="detail-line">安排时刻：{{selected.clockInfo.timeReason}}</text><view wx:for="{{selected.evidence}}" wx:key="index" class="evidence"><text class="quiet">{{item.name}}</text><text class="detail-line" selectable>{{item.quote}}</text></view></view><view class="field-label">日期（留空清除）</view
        ><input
          value="{{editDate}}"
          data-field="editDate"
          bindinput="onEdit"
          placeholder="明天下午三点 / YYYY-MM-DD"
        /><view class="field-label">时刻（留空按 23:59 安排）</view><input value="{{editTime}}" data-field="editTime" bindinput="onEdit" placeholder="HH:mm"/><view class="button-row"
          ><button hover-class="btn-press" class="primary" bindtap="saveEdit" disabled="{{!editTitle.length}}">保存修改</button
          ><button hover-class="btn-press" class="small-button" bindtap="cancelEdit">取消</button></view
        ></block
      >
      <block wx:else
        ><text class="detail-title">{{selected.title}}</text
        ><text class="detail-summary" selectable>{{selected.summary}}</text
        ><text wx:if="{{selected.date}}" class="due-label"
          >{{selected.timeLabel || (selected.date + ' ' + selected.time)}}</text
        ><text wx:if="{{selected.clockInfo.timeInferred}}" class="detail-line">安排时刻：{{selected.clockInfo.timeReason}}</text><view wx:if="{{!selected.deleted}}" class="button-row detail-actions"
          ><button class="chip primary-action" data-id="{{selected.id}}" bindtap="toggleDone" disabled="{{!!checkingId}}" hover-class="chip-press" hover-stop-propagation="{{true}}">
            {{selected.kind === 'habit' ? (selected.checked ? '撤销今日打卡' : '今日打卡') : selected.done ? '✓ 已完成 · 撤回' : '○ 标记完成'}}</button
          ><button hover-class="chip-press" class="chip" data-id="{{selected.id}}" bindtap="toggleStar">
            {{selected.starred ? '★ 已星标' : '☆ 星标'}}</button
          ><button hover-class="chip-press" class="chip" data-id="{{selected.id}}" bindtap="togglePin">
            {{selected.pinned ? '取消置顶' : '置顶'}}</button
          ><button class="small-button" bindtap="beginEdit" hover-class="btn-press" hover-stop-propagation="{{true}}">编辑</button
          ><button wx:if="{{selected.attachments.length}}" class="small-button" bindtap="jumpToMaterials" hover-class="btn-press">打开附件 · {{selected.attachments.length}} 份</button><text wx:if="{{selected.kind === 'habit'}}" class="detail-habit-status">{{selected.checked ? '今日已打卡' : '今日待打卡'}} · 累计 {{selected.checkinCount}} 天</text></view
        >
        <view wx:if="{{selected.facts.length}}" class="detail-section"
          ><text class="subheading">原文要求</text
          ><text
            wx:for="{{selected.facts}}"
            wx:key="index"
            class="detail-line"
            selectable
            >• {{item}}</text
          ></view
        ><view wx:if="{{selected.nextSteps.length}}" class="detail-section"
          ><text class="subheading">下一步建议</text
          ><text
            wx:for="{{selected.nextSteps}}"
            wx:key="index"
            class="detail-line"
            >→ {{item}}</text
          ></view
        ><view wx:if="{{selected.uncertainties.length}}" class="detail-section"
          ><text class="subheading">待确认</text
          ><text
            wx:for="{{selected.uncertainties}}"
            wx:key="index"
            class="detail-line"
            >{{item}}</text
          ></view
        ><view wx:if="{{selected.evidence.length}}" class="detail-section"
          ><text class="subheading">原文依据</text
          ><view wx:for="{{selected.evidence}}" wx:key="index" class="evidence"
            ><text class="quiet">{{item.name}}</text
            ><text class="detail-line" selectable>“{{item.quote}}”</text></view
          ></view
        >
        <view id="detail-materials" class="detail-section"><view class="section-top"><text class="subheading">文件附件与原文</text
            ><button wx:if="{{selected.sourceText}}" hover-class="text-press" class="text-button" bindtap="copySource">
              复制原文
            </button></view
          ><template wx:for="{{selected.attachments}}" wx:for-item="file" wx:key="id" is="attachmentActions" data="{{file, packet: selected.packetId, disabled: filesBusy || selected.deleted}}"/><text wx:if="{{!selected.attachments.length}}" class="quiet">这次投递没有文件附件。</text><text wx:if="{{selected.sourceText}}" class="detail-line evidence" selectable>{{selected.sourceText}}</text
          ><text wx:if="{{selected.processing}}" class="detail-line">{{selected.processing}}</text><view wx:for="{{selected.reading}}" wx:key="id" class="evidence"><text class="quiet">{{item.name}} · {{item.label}}</text><text class="detail-line">{{item.covered}}</text><text wx:if="{{item.missing}}" class="detail-line">{{item.missing}}</text><text wx:if="{{item.reason}}" class="quiet">{{item.reason}}</text></view><view wx:for="{{selected.sources}}" wx:key="id" class="evidence"
            ><text class="quiet">{{item.name}}</text
            ><text class="detail-line" selectable>{{item.text}}</text></view
          ></view
        >
        <view class="detail-section"
          ><text class="subheading">补充记录</text
          ><view wx:for="{{selected.additions}}" wx:key="id" class="evidence"
            ><text class="detail-line" selectable>{{item.text}}</text
            ><text class="quiet">{{item.at}}</text></view
          ><block wx:if="{{!selected.deleted}}">
            <textarea
              class="edit-area"
              value="{{addition}}"
              data-field="addition"
              bindinput="onEdit"
              maxlength="4000"
              placeholder="补充进展，保留原文依据"
            /><button hover-class="btn-press" class="small-button" bindtap="addNote" disabled="{{!addition.length}}">
              保存补充
            </button></block
          ></view
        >
        <view wx:if="{{!selected.deleted}}" class="detail-section detail-ai"
          ><text class="subheading">和 AI 说一声</text
          ><textarea
            class="edit-area"
            value="{{chatInput}}"
            data-field="chatInput"
            bindinput="onEdit"
            maxlength="4000"
            placeholder="只针对当前事项提问或修改"
          /><text class="quiet">新版服务端对话依据已保存事项与本轮指令，不重新读取原件；发送会产生调用费用。</text
          ><button
            hover-class="btn-press" class="small-button"
            bindtap="chatWithItem"
            disabled="{{jobBusy || !chatInput.length}}"
          >
            {{jobBusy ? '正在处理…' : '发送给当前事项'}}
          </button></view
        ><view wx:if="{{selected.chat.length}}" class="detail-section"
          ><text class="subheading">和 AI 说一声 · 历史对话</text
          ><view wx:for="{{selected.chat}}" wx:key="id" class="evidence"
            ><text class="quiet">{{item.role === 'user' ? '你' : '拾序'}}</text
            ><text class="detail-line" selectable>{{item.text}}</text></view
          ></view
        ><view wx:if="{{selected.history.length}}" class="detail-section"
          ><text class="subheading">修改记录</text
          ><view wx:for="{{selected.history}}" wx:key="index" class="evidence"
            ><text class="quiet">{{item.at}} · {{item.source}}</text
            ><text class="detail-line" selectable
              >{{item.field}}：{{item.before}} → {{item.after}}</text
            ></view
          ></view
        >
        <view class="detail-section button-row detail-danger"
          ><block wx:if="{{selected.deleted}}"
            ><button
              hover-class="btn-press" class="small-button"
              data-id="{{selected.id}}"
              bindtap="restoreItem"
            >
              恢复事项</button
            ><button
              hover-class="text-press" class="text-button danger"
              data-id="{{selected.id}}"
              bindtap="purgeItem"
            >
              永久删除卡片
            </button></block
          ><button
            wx:else
            hover-class="text-press" class="text-button danger"
            data-id="{{selected.id}}"
            bindtap="confirmRemoveItem"
          >
            移入最近删除（保留同行事项）
          </button></view
        >
      </block></scroll-view
    ></view
  ></view
>
<view wx:if="{{skinOpen}}" class="scrim skin-scrim" bindtap="closeSkins"
  ><view class="sheet skin-market-sheet" catchtap="stopTap"
    ><view class="sheet-handle"></view
    ><view wx:if="{{error}}" class="error panel-feedback" selectable>{{error}}</view><view class="section-top skin-market-header"
      ><view
        ><text class="section-title">皮肤市场</text></view
      ><button hover-class="icon-press" class="icon-button skin-market-close" aria-label="关闭皮肤市场" bindtap="closeSkins">×</button></view
    ><scroll-view scroll-y class="sheet-scroll"
      ><block wx:if="{{!skinEditor}}"
        ><view class="skin-preview {{previewSkin.id === 'ice' ? 'is-plain-preview' : ''}}" style="background:{{previewSkin.color}}"
          ><view class="skin-preview-stage skin-mascot {{previewSkin.id === 'ice' ? 'is-plain-preview' : previewSkin.id === 'bunny' ? 'with-fox' : ''}} {{skinAnimating ? 'skin-interacting' : ''}}" data-motion="{{skinAnimating ? previewSkin.motion : 'idle'}}" bindtap="interactSkin"><image wx:if="{{previewSkin.id !== 'bunny' || !skinAnimating}}" src="{{previewSkin.image}}" mode="{{previewSkin.id === 'ice' ? 'widthFix' : 'aspectFit'}}" animation="{{previewSkin.id === 'ice' ? null : skinAnimation}}" class="preview-art skin-body skin-motion-{{!skinNativeMotion && skinAnimating ? previewSkin.motion : 'idle'}} {{previewSkin.id === 'ice' ? 'is-plain-art' : ''}}"/><fox-player wx:if="{{previewSkin.id === 'bunny'}}" class="fox-player {{skinAnimating ? 'is-playing' : ''}}" position="{{bunnyPosition}}" bindready="foxResourceReady" binderror="foxResourceError"/><text wx:if="{{previewSkin.id !== 'ice' && previewSkin.id !== 'bunny'}}" class="skin-bubble">{{skinMessage}}</text><text wx:if="{{previewSkin.id !== 'ice' && previewSkin.id !== 'bunny'}}" class="skin-spark skin-spark-one">✦</text><text wx:if="{{previewSkin.id !== 'ice' && previewSkin.id !== 'bunny'}}" class="skin-spark skin-spark-two">✧</text></view><text class="subheading">{{previewSkin.name}}</text
          ><view wx:if="{{previewSkin.art === 'custom'}}" class="button-row"><button hover-class="btn-press" class="small-button" bindtap="feedSkin">试着喂一口</button></view
          ></view
        ><view class="skin-grid"
          ><view
            wx:for="{{skins}}"
            wx:key="id"
            hover-class="card-press" class="skin-card {{activeSkin.id === item.id ? 'selected' : ''}}"
            data-id="{{item.id}}"
            bindtap="previewSkin"
            style="background:{{item.color}}"
            ><image src="{{item.image}}" mode="aspectFit" /><text
              class="skin-name"
              >{{item.name}}</text

            ><view wx:if="{{item.art === 'custom'}}" class="button-row"
              ><button
                hover-class="text-press" class="text-button"
                data-id="{{item.id}}"
                catchtap="editSkin"
              >
                编辑</button
              ><button
                hover-class="text-press" class="text-button danger"
                data-id="{{item.id}}"
                catchtap="deleteCustomSkin"
              >
                删除
              </button></view
            ></view
          ></view
        ><button hover-class="btn-press" class="small-button more-button" bindtap="editSkin">
          ＋ 自己做一个</button
        ><text class="settings-copy"
          >共用桌面预设与原画。自定义收藏只保存在当前设备，不随事项同步。</text
        ></block
      ><block wx:else
        ><image
          wx:if="{{skinForm.image}}"
          class="preview-art"
          src="{{skinForm.image}}"
          mode="aspectFit"
        /><button hover-class="btn-press" class="small-button" bindtap="chooseSkinImage">
          选择角色图片</button
        ><text class="field-label">名字</text
        ><input
          value="{{skinForm.name}}"
          data-field="name"
          bindinput="onSkinField"
          maxlength="20"
        /><text class="field-label">简介</text
        ><input
          value="{{skinForm.description}}"
          data-field="description"
          bindinput="onSkinField"
          maxlength="60"
        /><text class="field-label">平时说的话</text
        ><input
          value="{{skinForm.hello}}"
          data-field="hello"
          bindinput="onSkinField"
          maxlength="40"
        /><text class="field-label">被点到时</text
        ><input
          value="{{skinForm.greeting}}"
          data-field="greeting"
          bindinput="onSkinField"
          maxlength="40"
        /><text class="field-label">收到投喂时</text
        ><input
          value="{{skinForm.feeding}}"
          data-field="feeding"
          bindinput="onSkinField"
          maxlength="40"
        /><text class="field-label">动作</text
        ><picker
          range="{{motionLabels}}"
          value="{{motionIndex}}"
          bindchange="onMotion"
          ><view hover-class="chip-press" class="filter">{{motionLabels[motionIndex]}} ▾</view></picker
        ><button hover-class="btn-press" class="primary" bindtap="saveCustomSkin">
          保存并使用
        </button></block
      ></scroll-view
    ></view
  ></view
>

<view wx:if="{{connected && taskPreview}}" class="scrim original-scrim" bindtap="closeTaskPreview">
  <view class="sheet" catchtap="stopTap">
    <view wx:if="{{error}}" class="error panel-feedback" selectable>{{error}}</view><view class="section-top"><text class="section-title">已完成内容</text><button class="icon-button" bindtap="closeTaskPreview" aria-label="关闭任务预览" hover-class="btn-press">×</button></view>
    <scroll-view scroll-y class="sheet-scroll"><view class="job-strip">
  <text>{{taskPreview.published ? '对应任务的原始整理结果，卡片中的人工修改另行保留。' : '尚未保存到世界或DDL；可在核对后收下有效部分。'}}</text>
  <view wx:for="{{taskPreview.items}}" wx:key="previewKey"><text>{{item.title}}</text><text>{{item.summary}}</text>
    <text wx:if="{{item.due}}">截止：{{item.due.date}} {{item.due.time}}</text>
    <text wx:for="{{item.facts}}" wx:for-item="fact" wx:key="*this">{{fact}}</text>
    <text wx:for="{{item.nextSteps}}" wx:for-item="step" wx:key="*this">下一步：{{step}}</text>
    <text wx:for="{{item.uncertainties}}" wx:for-item="uncertain" wx:key="*this">待核对：{{uncertain}}</text>
    <text wx:for="{{item.evidence}}" wx:for-item="evidence" wx:key="name">{{evidence.name}}：{{evidence.quote || '已保留来源定位'}}</text>
  </view>
  <text wx:if="{{!taskPreview.items.length}}">暂无已通过依据核对的可预览内容。</text>
  <button wx:if="{{taskPreview.nextOffset !== null}}" data-id="{{taskPreview.taskId}}" data-offset="{{taskPreview.nextOffset}}" bindtap="taskPreview" disabled="{{jobBusy}}" hover-class="btn-press">下一页预览</button>
</view></scroll-view></view></view>
<view wx:if="{{originalPreview}}" class="scrim original-scrim" bindtap="closeOriginal"><view class="sheet" catchtap="stopTap"><view class="sheet-handle"></view><view class="section-top"><text class="subheading">{{originalPreview.name}}</text><button class="icon-button" bindtap="closeOriginal" hover-class="icon-press" hover-stop-propagation="{{true}}">×</button></view><button class="small-button" data-id="{{originalPreview.id}}" data-packet="{{originalPreview.packet}}" bindtap="exportAttachment" disabled="{{filesBusy}}" hover-class="btn-press">导出原件</button><view wx:if="{{error}}" class="error panel-feedback" selectable>{{error}}</view><text wx:if="{{originalPreview.truncated}}" class="quiet">仅预览前 60000 字，原件未截断。</text><scroll-view scroll-y class="sheet-scroll"><text class="detail-line" selectable>{{originalPreview.text}}</text></scroll-view></view></view>

<view wx:if="{{dragGhost}}" id="drag-ghost" class="drag-ghost {{dragSettling ? 'is-settling' : ''}}" style="transform: {{dragGhost.transform || 'scale(1.025)'}}; height: {{dragGhost.height}}px; left: {{dragGhost.left}}px; top: {{dragGhost.top}}px; width: {{dragGhost.width}}px;"><text class="drag-ghost-label">移动中 · 松手放下</text><text class="drag-ghost-title">{{dragGhost.title}}</text><text class="drag-ghost-summary">{{dragGhost.summary}}</text></view>
<view wx:if="{{dragId}}" class="drag-toolbar"><text>{{dragNotice}}</text><button bindtap="cancelDrag" hover-class="btn-press" hover-stop-propagation="{{true}}">取消移动</button></view>
