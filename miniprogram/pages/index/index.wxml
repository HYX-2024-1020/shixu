          maxlength="20"
        /><text class="field-label">简介</text
        ><input
          value="{{skinForm.description}}"
          data-field="description"
          bindinput="onSkinField"
          maxlength="60"
        /><text class="field-label">平时说的话</text
        ><input
          value="{{skinForm.hello}}"
          data-field="hello"
          bindinput="onSkinField"
          maxlength="40"
        /><text class="field-label">被点到时</text
        ><input
          value="{{skinForm.greeting}}"
          data-field="greeting"
          bindinput="onSkinField"
          maxlength="40"
        /><text class="field-label">收到投喂时</text
        ><input
          value="{{skinForm.feeding}}"
          data-field="feeding"
          bindinput="onSkinField"
          maxlength="40"
        /><text class="field-label">动作</text
        ><picker
          range="{{motionLabels}}"
          value="{{motionIndex}}"
          bindchange="onMotion"
          ><view hover-class="chip-press" class="filter">{{motionLabels[motionIndex]}} ▾</view></picker
        ><button hover-class="btn-press" class="primary" bindtap="saveCustomSkin">
          保存并使用
        </button></block
      ></scroll-view
    ></view
  ></view
>

<view wx:if="{{originalPreview}}" class="scrim original-scrim" bindtap="closeOriginal"><view class="sheet" catchtap="stopTap"><view class="sheet-handle"></view><view class="section-top"><text class="subheading">{{originalPreview.name}}</text><button class="icon-button" bindtap="closeOriginal" hover-class="icon-press" hover-stop-propagation="{{true}}">×</button></view><text wx:if="{{originalPreview.truncated}}" class="quiet">仅预览前 60000 字，原件未截断。</text><scroll-view scroll-y class="sheet-scroll"><text class="detail-line" selectable>{{originalPreview.text}}</text></scroll-view></view></view>

<view wx:if="{{dragGhost}}" id="drag-ghost" class="drag-ghost {{dragSettling ? 'is-settling' : ''}}" style="transform: {{dragGhost.transform || 'scale(1.025)'}}; height: {{dragGhost.height}}px; left: {{dragGhost.left}}px; top: {{dragGhost.top}}px; width: {{dragGhost.width}}px;"><text class="drag-ghost-label">移动中 · 松手放下</text><text class="drag-ghost-title">{{dragGhost.title}}</text><text class="drag-ghost-summary">{{dragGhost.summary}}</text></view>
<view wx:if="{{dragId}}" class="drag-toolbar"><text>{{dragNotice}}</text><button bindtap="cancelDrag" hover-class="btn-press" hover-stop-propagation="{{true}}">取消移动</button></view>
