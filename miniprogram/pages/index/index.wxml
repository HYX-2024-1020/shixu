<wxs module="dragGesture" src="../../lib/drag-gesture.wxs"/>
<template name="deliveryJob">
  <view wx:if="{{job || submitting}}" class="job-line delivery-job">
    <text>AI 整理 · {{job ? jobLabels[job.state] || '待核对' : '正在提交'}}</text>
    <text wx:if="{{job.error}}" selectable>{{job.error}}</text>
    <text wx:if="{{job.pdfProgressLabel}}">{{job.pdfProgressLabel}}</text>
    <text wx:if="{{job.mergeLabel}}">{{job.mergeLabel}}</text>
    <text wx:if="{{job.state === 'done' && !hasCards}}">整理已完成，暂无可显示的卡片。</text>
    <view class="button-row">
      <button wx:if="{{job.hasPreview}}" class="small-button" data-id="{{job.id}}" bindtap="taskPreview" disabled="{{jobBusy}}" hover-class="btn-press">查看已读内容</button>
      <button wx:if="{{job.canStop}}" class="small-button" data-id="{{job.id}}" data-action="stop" bindtap="taskAction" disabled="{{jobBusy}}" hover-class="btn-press">停止</button>
      <button wx:if="{{job.canContinue}}" class="small-button" data-id="{{job.id}}" data-action="continue" bindtap="taskAction" disabled="{{jobBusy}}" hover-class="btn-press">继续整理</button>
      <button wx:if="{{job.canAcceptPartial}}" class="small-button" data-id="{{job.id}}" data-action="accept-partial" bindtap="taskAction" disabled="{{jobBusy}}" hover-class="btn-press">收下有效部分</button>
      <button wx:if="{{job.canCompleteRemaining}}" class="small-button" data-id="{{job.id}}" data-action="remaining" bindtap="taskAction" disabled="{{jobBusy}}" hover-class="btn-press">整理剩余材料</button>
    </view>
  </view>
</template>
<template name="attachmentActions">
  <view class="draft-file">
    <text>{{file.name}}</text>
    <view class="attachment-file-actions">
      <button hover-class="text-press" class="text-button" data-id="{{file.id}}" data-packet="{{packet}}" bindtap="openAttachment" disabled="{{disabled}}">预览</button>
      <button hover-class="text-press" class="text-button" data-id="{{file.id}}" data-packet="{{packet}}" bindtap="exportAttachment" disabled="{{disabled}}">导出</button>
    </view>
  </view>
</template>
<template name="ddlCard">
  <view style="{{row.dragStyle}}" class="ddl-item urgency-{{row.urgency}} drag-card {{dragId === row.id ? 'drag-placeholder' : ''}} {{leavingId === row.id ? 'is-leaving' : ''}}" data-id="{{row.id}}" bindtouchstart="dragTouchStart" bindlongpress="startDrag" bindtouchmove="{{dragGesture.move}}" bindtouchend="{{dragGesture.end}}" bindtouchcancel="{{dragGesture.cancel}}" data-dragging="{{!!dragId}}" data-follow="{{dragView}}">
    <view class="ddl-time"><text class="ddl-countdown cd-{{row.countdownStatus}}">{{row.countdown}}</text><text class="ddl-date">{{row.date || '待确认'}}</text><text class="ddl-clock">{{row.time || '23:59'}}</text><button class="ddl-verify-button" aria-label="核对截止时间" data-id="{{row.id}}" data-action="verifyDdl" bindtap="onCardAction" hover-class="text-press" hover-stop-propagation="{{true}}">核对时间 ↗</button></view>
    <view class="ddl-row"><button size="mini" class="done-button {{row.done || (row.kind === 'habit' && row.checked) ? 'checked' : ''}} {{checkingId === row.id ? 'is-checking' : ''}}" aria-label="{{row.kind === 'habit' ? '今日打卡 / 撤销打卡' : row.done ? '撤销完成' : '标记完成'}}" data-id="{{row.id}}" data-action="toggleDone" bindtap="onCardAction" hover-class="done-press" hover-stop-propagation="{{true}}"><view class="completion-orbit"><view wx:if="{{row.done || (row.kind === 'habit' && row.checked) || checkingId === row.id}}" class="completion-check"><view class="check-short"></view><view class="check-long"></view></view></view></button><view class="ddl-copy" data-id="{{row.id}}" bindtap="toggleCard" aria-expanded="{{expandedCardId === row.id}}" hover-class="row-press"><text class="item-title">{{row.title}}</text><text class="ddl-status">{{row.kind === 'habit' ? (row.checked ? '今日已打卡' : '今日待打卡') : row.done ? '已完成' : '待完成'}}{{row.group ? ' · ' + row.group : ''}}{{row.startDate ? ' · 时间区间' : ''}} · {{expandedCardId === row.id ? '收起 ▴' : '展开 ▾'}}</text></view></view>
    <view wx:if="{{expandedCardId === row.id}}" class="ddl-card-summary"><text selectable>{{row.summary || row.title}}</text><text wx:if="{{row.startDate}}">开始 {{row.startDate}} {{row.startTime || '00:00'}} → {{row.date}} {{row.time}}</text></view>
    <view wx:if="{{row.cardFiles.length}}" class="card-files"><view wx:for="{{row.cardFiles}}" wx:for-item="file" wx:key="id" class="card-file" role="button" aria-label="{{file.name}}" data-action="openMaterials" data-id="{{row.id}}" bindtap="onCardAction"><text class="file-extension">{{file.extension}}</text><text class="card-file-name">{{file.name}}</text><text>↗</text></view></view>
    <view class="ddl-footer"><text>{{row.done ? '已完成' : '待完成'}}</text><view class="ddl-footer-actions"><button class="compact-delete" data-id="{{row.id}}" data-action="confirmRemoveItem" bindtap="onCardAction" aria-label="删除事项" hover-class="text-press" hover-stop-propagation="{{true}}">删除</button><button class="ddl-detail-button" data-id="{{row.id}}" data-action="openItem" bindtap="onCardAction" hover-class="text-press">查看详情 ↗</button></view></view>
  </view>
</template>
<template name="itemCard">
  <view style="{{row.dragStyle}}" class="xc-card {{expandedCardId === row.id ? 'is-expanded' : 'is-collapsed'}} kind-{{row.kind}} drag-card xc-shadow-{{row.shadowIndex}} {{dragId === row.id ? 'drag-placeholder' : ''}} {{row.done ? 'xc-done-card' : ''}} {{leavingId === row.id ? 'is-leaving' : ''}}" data-id="{{row.id}}" data-no-drag="{{!allowDrag || expandedCardId === row.id}}" bindtouchstart="dragTouchStart" bindlongpress="startDrag" bindtouchmove="{{dragGesture.move}}" bindtouchend="{{dragGesture.end}}" bindtouchcancel="{{dragGesture.cancel}}" data-dragging="{{!!dragId}}" data-follow="{{dragView}}">
    <view class="xc-top">
      <button wx:if="{{row.deleted}}" class="xc-restore xc-hit" data-card-control="{{true}}" aria-label="恢复事项" data-action="restoreItem" data-id="{{row.id}}" bindtap="onCardAction" hover-class="xc-press">恢复</button>
      <button wx:else class="xc-complete xc-hit {{checkingId === row.id ? 'is-checking' : ''}}" data-card-control="{{true}}" aria-label="{{row.kind === 'habit' ? (row.checked ? '撤销今日打卡' : '今日打卡') : row.done ? '撤销完成' : '标记完成'}}" aria-pressed="{{row.done || row.checked}}" data-action="toggleDone" data-id="{{row.id}}" bindtap="onCardAction" hover-class="xc-press">
        <view data-card-control="{{true}}" class="xc-circle {{row.done || (row.kind === 'habit' && row.checked) ? 'xc-checked' : ''}}"><view wx:if="{{row.done || (row.kind === 'habit' && row.checked) || checkingId === row.id}}" class="completion-check"><view class="check-short"></view><view class="check-long"></view></view></view>
      </button>
      <button class="xc-title-touch" data-id="{{row.id}}" data-action="toggleCard" bindtap="onCardAction" hover-class="xc-press" aria-expanded="{{expandedCardId === row.id}}"><text class="xc-title">{{row.title}}</text></button>
      <view class="xc-quick-actions">
        <button wx:if="{{!row.deleted}}" class="xc-star xc-hit {{row.starred ? 'xc-starred' : ''}}" data-card-control="{{true}}" aria-label="{{row.starred ? '取消星标' : '添加星标'}}" aria-pressed="{{row.starred}}" data-action="toggleStar" data-id="{{row.id}}" bindtap="onCardAction" hover-class="xc-press">{{row.starred ? '★' : '☆'}}</button>
        <button class="xc-chevron xc-hit {{expandedCardId === row.id ? 'xc-chevron-open' : ''}}" data-card-control="{{true}}" aria-label="{{expandedCardId === row.id ? '收起卡片' : '展开卡片'}}" aria-expanded="{{expandedCardId === row.id}}" data-action="toggleCard" data-id="{{row.id}}" bindtap="onCardAction" hover-class="xc-press"><view class="xc-chevron-mark" data-card-control="{{true}}"/></button>
      </view>
    </view>
    <view class="xc-meta">
      <text class="xc-kind-label">{{row.kindLabel}}</text>
      <text wx:if="{{row.kind === 'habit'}}" class="xc-project">{{row.checked ? '今日已打卡' : '今日待打卡'}} · {{row.checkinCount}} 天</text>
      <text wx:elif="{{row.timeLabel}}" class="xc-due {{row.countdownStatus === 'overdue' ? 'xc-overdue' : ''}}">{{row.countdownStatus === 'overdue' ? row.countdown + ' · ' : ''}}{{row.compactTimeLabel}}</text>
      <text wx:if="{{row.group}}" class="xc-project">{{row.group}}</text>
      <text wx:if="{{row.conflict}}" class="xc-project xc-conflict">待处理冲突</text>
      <text wx:elif="{{row.pinned}}" class="xc-project">已置顶</text>
      <text wx:if="{{!row.deleted && row.attachmentCount}}" class="xc-project">{{row.attachmentCount}} 份附件</text>
      <button wx:if="{{expandedCardId !== row.id}}" class="xc-compact-detail" data-card-control="{{true}}" aria-label="打开事项详情" data-action="openItem" data-id="{{row.id}}" bindtap="onCardAction" hover-class="xc-press">详情 ↗</button>
    </view>
    <block wx:if="{{expandedCardId === row.id}}">
      <view wx:if="{{row.summary || (!row.deleted && row.cardFiles.length)}}" class="xc-expanded">
        <text wx:if="{{row.summary}}" class="xc-summary" selectable>{{row.summary}}</text>
        <view wx:if="{{!row.deleted && row.cardFiles.length}}" class="card-files">
          <button wx:for="{{row.cardFiles}}" wx:for-item="file" wx:key="id" class="card-file" aria-label="查看附件 {{file.name}}" data-action="openMaterials" data-id="{{row.id}}" bindtap="onCardAction" hover-class="xc-press"><text class="file-extension">{{file.extension}}</text><text class="card-file-name">{{file.name}}</text><text>↗</text></button>
        </view>
      </view>
      <view class="xc-footer">
        <button wx:if="{{row.conflict}}" class="xc-link xc-delete" data-id="{{row.packetId}}" bindtap="resolveConflict" hover-class="xc-press">处理冲突</button>
        <button wx:elif="{{!row.deleted}}" class="xc-link xc-delete" aria-label="删除事项" data-action="confirmRemoveItem" data-id="{{row.id}}" bindtap="onCardAction" hover-class="xc-press">移入最近删除</button>
        <button class="xc-link xc-detail" aria-label="打开事项详情" data-action="openItem" data-id="{{row.id}}" bindtap="onCardAction" hover-class="xc-press">查看详情 ↗</button>
      </view>
    </block>
  </view>
</template>
<scroll-view scroll-y="{{true}}" enhanced="{{true}}" enable-passive="{{false}}" scroll-top="{{dragScrollTop}}" scroll-into-view="{{captureResultAnchor}}" refresher-enabled="{{tab === 'world' && connected}}" refresher-triggered="{{refreshingWorld}}" bindrefresherrefresh="refreshWorld" bindscroll="onWorkspaceScroll" class="workspace-scroll"><view class="page">
  <view class="heading">
    <view class="brand"><text class="brand-mark">拾</text><text>拾序</text><text class="brand-en">SHIXU</text></view>
    <view class="header-actions"><button hover-class="btn-press" class="small-button market-button" bindtap="openSkins" aria-label="打开皮肤市场">皮肤</button><button hover-class="btn-press" class="small-button" data-tab="settings" bindtap="switchTab" aria-label="{{tab === 'settings' ? '关闭连接设置' : '打开连接设置'}}">{{tab === 'settings' ? '关闭' : '设置'}}</button></view>
  </view>
  <view wx:if="{{updateReady}}" class="update-banner" bindtap="applyUpdate" hover-class="row-press"
    >新版本已就绪，保存后更新 →</view
  ><view wx:if="{{error}}" class="error" selectable>{{error}}</view
  ><view wx:if="{{notice}}" class="notice">{{notice}}</view>
  <view wx:if="{{localMode && savedAccount && tab !== 'settings'}}" class="workspace-status">
    <text>当前在本机空间</text><button class="small-button" bindtap="resumeAccount" disabled="{{connecting || filesBusy}}" hover-class="btn-press">切回云端账号</button>
  </view>
  <view wx:if="{{tab === 'capture'}}" class="capture">
    <view class="ai-entry"><text>{{!connected ? 'AI 未连接 · 可先保存原文' : capabilities.aiOrganize ? 'AI 整理已可用' : '同步已连接 · 服务端 AI 未启用'}}</text><button hover-class="text-press" class="text-button" bindtap="openAiSettings">AI 连接</button></view>
    <view class="hero">
      <view class="hero-title"><text class="line-break">什么都行，</text><text class="hero-highlight">喂给它。</text></view>
      <view class="home-character {{activeSkin.id === 'ice' ? 'with-voices' : activeSkin.id === 'bunny' ? 'with-fox' : ''}}"><view class="bucket-drawing skin-mascot {{!skinOpen && skinAnimating ? 'skin-interacting' : ''}}" data-motion="{{!skinOpen && skinAnimating ? activeSkin.motion : 'idle'}}" bindtap="interactSkin"><image wx:if="{{activeSkin.id !== 'bunny' || !skinAnimating || skinOpen}}" animation="{{activeSkin.id === 'ice' || skinOpen ? null : skinAnimation}}" class="mascot skin-body skin-motion-{{!skinNativeMotion && !skinOpen && skinAnimating ? activeSkin.motion : 'idle'}} {{activeSkin.id === 'ice' ? 'is-plain-art' : ''}}" src="{{activeSkin.image}}" mode="{{activeSkin.id === 'ice' ? 'widthFix' : 'aspectFit'}}"/><fox-player wx:if="{{activeSkin.id === 'bunny'}}" class="fox-player {{skinAnimating && !skinOpen ? 'is-playing' : ''}}" position="{{bunnyPosition}}" bindready="foxResourceReady" binderror="foxResourceError"/><text wx:if="{{activeSkin.id !== 'ice' && activeSkin.id !== 'bunny'}}" class="skin-bubble">{{skinOpen ? activeSkin.hello : skinMessage}}</text><text wx:if="{{activeSkin.id !== 'ice' && activeSkin.id !== 'bunny'}}" class="skin-spark skin-spark-one">✦</text><text wx:if="{{activeSkin.id !== 'ice' && activeSkin.id !== 'bunny'}}" class="skin-spark skin-spark-two">✧</text></view><view wx:if="{{activeSkin.id === 'ice'}}" class="ice-home-voices"><button wx:for="{{iceVoices}}" wx:key="id" data-voice="{{item.id}}" bindtap="changeIceVoice" class="small-button {{iceVoice === item.id ? 'voice-selected' : ''}}" aria-label="{{item.label}}" aria-pressed="{{iceVoice === item.id}}" hover-class="btn-press"><text class="ice-voice-label">{{item.label}}</text></button></view></view>
    </view>
    <view class="editor">
      <textarea
        value="{{draft}}"
        bindinput="onDraft"
        maxlength="60000"
        placeholder="写下来，或先选一个附件…"
        aria-label="投递文字"
        cursor-spacing="30"
        adjust-position
        auto-height
      /><view class="editor-foot"
        ><text>{{draft.length}} / 60000</text></view
      ></view
    >
    <view class="button-row attachment-actions"><button hover-class="btn-press" class="small-button" bindtap="chooseFiles" disabled="{{filesBusy || draftFiles.length >= 20}}">＋ 聊天文件</button><button hover-class="btn-press" class="small-button" bindtap="chooseImages" disabled="{{filesBusy || draftFiles.length >= 20}}">＋ 图片 / 拍照</button></view>
    <text class="settings-copy attachment-hint">{{draftFiles.length ? draftFiles.length + ' / 20 份已选 · ' : ''}}每份原件最多 10 MB，最多 20 份。</text>
    <view wx:for="{{draftFiles}}" wx:key="id" class="draft-file"><view class="draft-file-copy"><text class="draft-file-name">{{item.name}}</text><text class="quiet">{{item.sizeLabel}} · 本机已保存</text></view><button hover-class="text-press" class="text-button" data-id="{{item.id}}" bindtap="removeDraftFile" aria-label="将 {{item.name}} 移出草稿">移出</button></view><view class="capture-toolbar"
      ><text class="quiet"
        >{{localMode ? '本机保存 · 连接后可导入同步' : '独立服务 · 离线修改会保留'}}</text
      ><button hover-class="btn-press" class="primary submit-button" bindtap="submit" disabled="{{connecting || filesBusy || (!draft.length && !draftFiles.length)}}" aria-label="投递当前文字和附件">
        喂给它
      </button></view
    >
    <view id="capture-result" class="section-top delivery-heading"
      ><text class="section-title"
        >{{currentRows.length ? '本次投喂' : '给想法一个落脚处'}}</text
      ><button hover-class="text-press" class="text-button" bindtap="toggleRecords">
        投递记录 · {{count}}
      </button></view
    >
    <view wx:if="{{!currentRows.length}}" class="empty card-paper"
      ><text class="empty-title">现在乱一点，也没关系。</text
      ><text>先留住原文，再把事情一件件理清。</text></view
    >
    <view wx:for="{{currentRows}}" wx:key="id" class="current-delivery"
      ><view class="card-paper"
        ><text class="badge"
          >{{item.status === 'ready' ? '已记录' : '原文已保存'}}</text
        ><text class="source-preview" selectable>{{item.text}}</text
        ><template wx:for="{{item.attachments}}" wx:for-item="file" wx:key="id" is="attachmentActions" data="{{file, packet: item.id, disabled: filesBusy}}"/><text class="item-summary">{{item.summary}}</text
        ><text wx:if="{{item.error}}" class="error">{{item.error}}</text>
        <template is="deliveryJob" data="{{job: item.organizeJob, jobLabels, jobBusy, submitting: organizingPacketId === item.id, hasCards: item.items.length}}"/>
        <view class="button-row"
          ><button
            wx:if="{{(!item.organizeJob && !item.summary) || item.organizeJob.retryable}}"
            hover-class="btn-press" class="small-button"
            data-id="{{item.id}}"
            bindtap="organizeRecord"
            disabled="{{jobBusy}}"
          >
            AI 整理</button
          ><button
            hover-class="text-press" class="text-button"
            data-id="{{item.id}}"
            bindtap="createManual"
          >
            ＋ 手动记成事项
          </button></view
        ></view
      ><block wx:for="{{item.items}}" wx:for-item="row" wx:key="id"
        ><template is="itemCard" data="{{row, sort, checkingId, leavingId, expandedCardId, dragId, dragView, allowDrag: tab === 'world'}}" /></block
    ></view>
  </view>
  <view wx:elif="{{tab === 'world'}}" class="world">
    <view class="world-heading"
      ><view
        ><text class="world-title"><text class="line-break">消化完了，</text>这是你的<text class="hero-highlight">世界。</text></text
        ></view
      ><image
        class="world-mascot {{activeSkin.id === 'ice' ? 'is-plain-art' : ''}}"
        src="{{activeSkin.image}}"
        mode="aspectFit"
        bindtap="openSkins"
    /></view>
    <view wx:if="{{connected}}" class="workspace-status">
      <text role="status">{{authExpired ? '账号授权已失效' : syncing ? '正在同步卡片…' : offline ? '当前离线 · 修改会保留' : syncStatus || '等待同步'}}</text>
      <button wx:if="{{authExpired}}" class="small-button" data-tab="settings" bindtap="switchTab" hover-class="btn-press">重新登录</button>
      <button wx:else class="small-button" bindtap="refreshWorld" disabled="{{refreshingWorld}}" loading="{{refreshingWorld}}" hover-class="btn-press">{{refreshingWorld ? '刷新中' : '刷新卡片'}}</button>
    </view>
    <view class="search-box"
      ><text class="search-icon" aria-hidden="true">⌕</text
      ><input
        value="{{query}}"
        bindinput="onQuery"
        placeholder="搜索标题、原文或附件名"
        aria-label="搜索世界卡片"
        confirm-type="search"
    /><button wx:if="{{query}}" class="search-clear" bindtap="clearSearch" hover-class="icon-press" aria-label="清空搜索">×</button></view>
    <view class="world-controls">
      <picker class="scope-picker" range="{{scopeLabels}}" value="{{scopeIndex}}" bindchange="chooseScope"><view class="scope-control" hover-class="chip-press"><text>{{scopeLabels[scopeIndex]}}</text><text>⌄</text></view></picker>
      <button class="filter-trigger {{filtersOpen ? 'is-open' : ''}} {{filterActive ? 'has-active' : ''}}" bindtap="toggleFilters" hover-class="chip-press" hover-stop-propagation="{{true}}" aria-expanded="{{filtersOpen}}">{{filtersOpen ? '收起筛选' : '筛选与排序'}}{{filterActive && !filtersOpen ? ' · 已选' : ''}}</button>
    </view>
    <view wx:if="{{filtersOpen}}" class="touch-filters">
      <picker range="{{kinds}}" value="{{kindIndex}}" bindchange="setKind"><view class="filter-field"><text>类型</text><text>{{kinds[kindIndex]}} ⌄</text></view></picker>
      <picker range="{{dates}}" value="{{dateIndex}}" bindchange="setDate"><view class="filter-field"><text>日期</text><text>{{dates[dateIndex]}} ⌄</text></view></picker>
      <picker range="{{sorts}}" value="{{sortIndex}}" bindchange="setSort"><view class="filter-field"><text>排序</text><text>{{sorts[sortIndex]}} ⌄</text></view></picker>
      <picker wx:if="{{groups.length}}" range="{{groupChoices}}" value="{{groupIndex}}" bindchange="chooseGroup"><view class="filter-field"><text>分组</text><text>{{groupChoices[groupIndex]}} ⌄</text></view></picker>
      <view class="filter-field"><text>仅星标</text><switch checked="{{starOnly}}" bindchange="toggleStarFilter" color="#7048e8"/></view>
      <view class="filter-field"><text>按分组查看</text><switch checked="{{grouped}}" bindchange="toggleGrouped" color="#7048e8"/></view>
      <view class="filter-footer"><button wx:if="{{filterActive}}" class="text-button filter-reset" bindtap="resetWorldFilters" hover-class="text-press">清除搜索与筛选</button><button class="filter-done" bindtap="toggleFilters" hover-class="btn-press" hover-stop-propagation="{{true}}">完成</button></view>
    </view>
    <view class="sync-line"
      ><text
        >{{localMode ? '资料保存在本机' : syncing ? '正在同步…' : pending ? pending + ' 个操作待同步' : '已连接个人服务'}} · {{matched}}
        张卡片</text
      ><button hover-class="text-press" class="text-button" bindtap="toggleRecords">
        投递记录
      </button></view
    >
    <scroll-view wx:if="{{categories.length > 1}}" scroll-x class="xc-categories"><view wx:for="{{categories}}" wx:key="key" role="button" class="xc-category kind-{{item.key}} {{kind === item.key ? 'xc-category-on' : ''}}" data-kind="{{item.key}}" bindtap="selectCardCategory" hover-class="xc-press">{{item.label}} {{item.count}}</view></scroll-view>
    <view wx:if="{{!items.length}}" class="empty card-paper"
      ><text class="empty-title"
        >{{filterActive ? '没有找到匹配的内容' : scope === 'done' ? '完成的事情，会留在这里。' : scope === 'trash' ? '这里还没有删除的事项。' : '给世界留一点生长的空间。'}}</text
      ><text>{{filterActive ? '换个关键词，或清除筛选后再看看。' : '尚未整理的文字可在投递记录中查看或手动记成事项。'}}</text
      ><button wx:if="{{filterActive}}" hover-class="btn-press" class="small-button empty-action" bindtap="resetWorldFilters">清除搜索与筛选</button
      ><button wx:elif="{{scope !== 'active'}}" hover-class="btn-press" class="small-button empty-action" data-scope="active" bindtap="setScope">回到待处理</button
      ><button wx:else hover-class="btn-press" class="small-button empty-action" bindtap="toggleRecords">查看投递记录</button></view
    >

    <block wx:if="{{grouped}}"
      ><view wx:for="{{sections}}" wx:key="key"
        ><text class="group-title">{{item.title}} · {{item.items.length}}</text
        ><view class="world-grid"><block wx:for="{{item.items}}" wx:for-item="row" wx:key="id"
