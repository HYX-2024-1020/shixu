# Independent administrator identity. Provision a unique password hash before startup.
SHIXU_ADMIN_USERNAME=operator
# scrypt:131072:8:1:64:<32 hex salt>:<128 hex key>
# Generate with hashAdminPassword() from server/admin-service.mjs in trusted provisioning.
SHIXU_ADMIN_PASSWORD_HASH=
SHIXU_ADMIN_PORT=8789
# This must match the browser's SSH tunnel origin exactly.
SHIXU_ADMIN_ORIGIN=http://127.0.0.1:8789
