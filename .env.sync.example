# Independent local synchronization service. Copy to .env.sync (gitignored).
# Set your own random passphrase; never put a model key in this client password.
SYNC_PASSWORD=
SYNC_HOST=127.0.0.1
SYNC_PORT=8788
SYNC_ORIGIN=http://127.0.0.1:8788
SYNC_DATA_DIR=data/sync-v2
WECHAT_APP_ID=wx03d8b4c63a26177c
# Optional server-side AI. Both opt-in and key are required; calls incur provider charges.
SYNC_AI_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
