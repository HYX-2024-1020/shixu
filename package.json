{
  "name": "shixu",
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/HYX-2024-1020/shixu.git"
  },
  "bugs": {
    "url": "https://github.com/HYX-2024-1020/shixu/issues"
  },
  "private": true,
  "version": "0.3.33",
  "type": "module",
  "scripts": {
    "workspace:check": "node scripts/check/check-development-base.mjs",
    "site:check": "node scripts/check/check-public-site.mjs",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/build/build-sw.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "check": "tsc -b",
    "test:e2e": "playwright test",
    "start": "node --env-file-if-exists=.env apps/server/index.mjs",
    "test:server": "node --test apps/server/server.test.mjs apps/server/database-schema.test.mjs apps/server/admin-service.test.mjs apps/server/admin-backend.test.mjs apps/server/admin-risk.test.mjs apps/server/admin-management.test.mjs apps/server/cloud-backup.test.mjs apps/server/console-gateway.test.mjs",
    "desktop:build": "tsc -b && vite build --base=/",
    "desktop:start": "npm run desktop:build && electron .",
    "desktop:pack": "npm run desktop:build && electron-builder --win --x64",
    "test:desktop": "node --test --test-concurrency=1 apps/desktop/*.test.cjs",
    "test:desktop:ui": "node scripts/desktop/desktop-smoke.mjs && node scripts/desktop/desktop-management-smoke.mjs && node scripts/desktop/desktop-ingest-smoke.mjs && node scripts/desktop/desktop-recovery-smoke.mjs && node scripts/desktop/desktop-upgrade-smoke.mjs && node scripts/desktop/desktop-performance-smoke.mjs && node scripts/desktop/desktop-preview-smoke.mjs && node scripts/desktop/desktop-chat-smoke.mjs && node scripts/desktop/desktop-polish-smoke.mjs && node scripts/desktop/desktop-motion-smoke.mjs && node scripts/desktop/desktop-spatial-smoke.mjs && node scripts/desktop/desktop-skins-smoke.mjs && node scripts/desktop/desktop-cloud-smoke.mjs && node scripts/desktop/desktop-ddl-smoke.mjs && node scripts/desktop/desktop-ddl-time-smoke.mjs && node scripts/desktop/desktop-completion-smoke.mjs && node scripts/desktop/desktop-sticker-smoke.mjs && node scripts/desktop/desktop-board-smoke.mjs",
    "sync:start": "node --env-file-if-exists=.env.sync apps/server/sync-server.mjs",
    "test:sync": "node --test apps/server/sync.test.mjs apps/server/sync-files.test.mjs apps/server/sync-accounts.test.mjs apps/server/sync-provider.test.mjs apps/miniprogram/tests/*.test.cjs",
    "sync:accounts": "node --env-file-if-exists=.env.sync apps/server/sync-multi-user.mjs",
    "sync:reading": "node --env-file-if-exists=.env.sync apps/server/reading-runtime.mjs",
    "sync:admin": "node --env-file-if-exists=.env.sync apps/server/sync-admin.mjs",
    "admin:start": "node --env-file-if-exists=.env.admin apps/server/admin-service.mjs",
    "sync:configure": "node scripts/ops/configure-sync-secrets.mjs",
    "test:sync:release": "node --test deploy/sync/release.test.mjs deploy/sync/cloud-release.test.mjs deploy/sync/configure-secrets.test.mjs deploy/sync/accounts-deployment.test.mjs",
    "mini:build": "node scripts/build/build-miniprogram.mjs",
    "mini:check": "node scripts/build/build-miniprogram.mjs --check",
    "mini:compile": "node scripts/check/check-miniprogram-compiler.mjs",
    "reading:archive:build": "node scripts/build/build-reading-archive.mjs",
    "reading:webp:build": "node scripts/build/build-reading-webp.mjs",
    "reading:pdf:visual:build": "node scripts/build/build-reading-pdf-visual.mjs",
    "test:mini": "node --test apps/miniprogram/tests/*.test.cjs",
    "mini:preview:sync": "node scripts/build/sync-miniprogram-preview.mjs"
  },
  "dependencies": {
    "7zip-bin-full": "26.5.1",
    "fflate": "^0.8.3",
    "jpeg-js": "0.4.4",
    "lucide-react": "^1.80.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sax": "1.6.1",
    "word-extractor": "^1.0.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "0.25.12",
    "prettier": "^3.6.2",
    "typescript": "~5.8.3",
    "vite": "^6.3.0",
    "vitest": "^5.0.5"
  },
  "main": "apps/desktop/main.cjs",
  "build": {
    "appId": "cn.shixu.desktop",
    "productName": "拾序",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "apps/desktop/**/*.cjs",
      "!apps/desktop/**/*.test.cjs",
      "package.json",
      "apps/web/public/desktop-icon.png",
      "!node_modules/7zip-bin-full/mac/**/*",
      "!node_modules/7zip-bin-full/linux/**/*",
      "!node_modules/7zip-bin-full/win/ia32/**/*",
      "!node_modules/7zip-bin-full/win/arm64/**/*",
      "!node_modules/7zip-bin-full/win/x64/7zc/**/*",
      "LICENSE"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "apps/web/public/desktop-icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "拾序",
      "artifactName": "Shixu-Setup-${version}.${ext}"
    },
    "asarUnpack": [
      "node_modules/7zip-bin-full/win/x64/**/*"
    ]
  },
  "description": "拾序 Windows 桌面整理工具"
}
