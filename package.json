{
  "name": "shixu",
  "private": true,
  "version": "0.3.7",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "check": "tsc -b",
    "test:e2e": "playwright test",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test:server": "node --test server/server.test.mjs",
    "desktop:build": "tsc -b && vite build --base=/",
    "desktop:start": "npm run desktop:build && electron .",
    "desktop:pack": "npm run desktop:build && electron-builder --win --x64",
    "test:desktop": "node --test desktop/*.test.cjs",
    "test:desktop:ui": "node scripts/desktop-smoke.mjs && node scripts/desktop-management-smoke.mjs && node scripts/desktop-ingest-smoke.mjs && node scripts/desktop-recovery-smoke.mjs && node scripts/desktop-upgrade-smoke.mjs && node scripts/desktop-performance-smoke.mjs && node scripts/desktop-preview-smoke.mjs && node scripts/desktop-chat-smoke.mjs && node scripts/desktop-polish-smoke.mjs && node scripts/desktop-motion-smoke.mjs && node scripts/desktop-spatial-smoke.mjs"
  },
  "dependencies": {
    "7zip-bin-full": "^26.4.1",
    "fflate": "^0.8.3",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "word-extractor": "^1.0.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "prettier": "^3.6.2",
    "typescript": "~5.8.3",
    "vite": "^6.3.0",
    "vitest": "^5.0.5"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "cn.shixu.desktop",
    "productName": "拾序",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*.cjs",
      "!desktop/**/*.test.cjs",
      "package.json",
      "public/desktop-icon.png",
      "!node_modules/7zip-bin-full/mac/**/*",
      "!node_modules/7zip-bin-full/linux/**/*",
      "!node_modules/7zip-bin-full/win/ia32/**/*",
      "!node_modules/7zip-bin-full/win/arm64/**/*",
      "!node_modules/7zip-bin-full/win/x64/7zc/**/*",
      "LICENSE"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/desktop-icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "拾序"
    },
    "asarUnpack": [
      "node_modules/7zip-bin-full/win/x64/**/*"
    ]
  },
  "description": "拾序 Windows 桌面整理工具"
}
